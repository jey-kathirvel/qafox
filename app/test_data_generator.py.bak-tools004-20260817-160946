    # Insert the dynamic dataset/project fragments after the
    # static HTML template has been built. Keeping the main
    # template as a normal string is intentional because the
    # Test Data Studio contains literal braces such as "{ }"
    # and JSON examples.

    content = content.replace(
        "{project_options}",
        project_options,
    )

    content = content.replace(
        "{dataset_cards}",
        dataset_cards,
    )

    content = content.replace(
        "{dataset_count}",
        str(dataset_count),
    )

    return content

