QAFOX_VALID_FUNCTIONAL_DATA_POLICY = """
QAFox AI Test Data Generator is a manual-testing utility.

Generate ONLY valid, functional, realistic synthetic test data.

MANDATORY RULES:

1. Every generated record must represent data that should
   normally pass standard functional validation.

2. Do NOT intentionally generate:
   - invalid values
   - malformed values
   - negative test scenarios
   - boundary violations
   - SQL injection strings
   - XSS payloads
   - command injection strings
   - security attack payloads
   - empty mandatory fields
   - null mandatory fields
   - incorrect data types
   - intentionally expired values
   - impossible dates
   - invalid email syntax
   - invalid phone syntax
   - invalid cross-field relationships

3. Generated information must be synthetic and suitable
   for testing. Do not imply that generated identities,
   addresses, account details or identifiers belong to
   real people.

4. Preserve cross-field consistency.

   Examples:
   - checkout must be after check-in
   - end date must be after start date
   - DOB must be a valid past date
   - age must agree with DOB when both exist
   - state/city/postal data should be internally coherent
   - totals should agree with quantity and price when
     those fields are related
   - email must use valid email syntax
   - mobile must follow the selected locale format

5. If the tester provides a JSON schema or custom fields,
   generate values matching the declared types and obvious
   constraints.

6. If a requested value cannot safely or reliably be
   represented as a real credential or official identifier,
   generate a clearly synthetic functional placeholder.

7. The tool is for MANUAL TESTING.
   Do not require an uploaded QAFox project.
   Do not require API test cases.
   Do not require an execution plan.

8. Prefer useful functional test data over test scenarios.

Return generated DATA, not descriptions of negative tests.
"""


def valid_functional_data_policy():
    return QAFOX_VALID_FUNCTIONAL_DATA_POLICY.strip()

def normalize_manual_testdata_request(payload):
    """
    Normalize AI Test Data Generator requests to valid
    functional manual-test data only.
    """

    if not isinstance(payload, dict):
        payload = {}

    normalized = dict(payload)

    normalized["mode"] = "valid"
    normalized["scenario"] = "functional"
    normalized["data_quality"] = "valid"
    normalized["manual_testing"] = True
    normalized["allow_negative"] = False
    normalized["allow_boundary_violation"] = False
    normalized["allow_security_payloads"] = False

    try:
        count = int(
            normalized.get(
                "count",
                normalized.get(
                    "row_count",
                    10,
                ),
            )
        )
    except Exception:
        count = 10

    normalized["count"] = max(
        1,
        min(
            count,
            100,
        ),
    )

    normalized["row_count"] = (
        normalized["count"]
    )

    return normalized





