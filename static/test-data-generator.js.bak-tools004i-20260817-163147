            ],
        },
    ];


    function normalize(text) {
        return String(text || "")
            .toLowerCase()
            .replace(/[^a-z0-9_ -]/g, " ")
            .replace(/\s+/g, " ")
            .trim();
    }


    function detectDomain(prompt) {

        const selected =
            byId("qa-testdata-domain")?.value
            || "auto";

        if (
            selected !== "auto"
            && domainKnowledge[selected]
        ) {
            return {
                key: selected,
                score: 100,
                source: "preset",
            };
        }

        const text = normalize(prompt);

        let best = {
            key: "general",
            score: 0,
            source: "inferred",
        };

        Object.entries(domainKnowledge)
            .forEach(([key, domain]) => {

                if (key === "general") {
                    return;
                }

                let score = 0;

                domain.keywords.forEach(
                    (keyword) => {

                        if (
                            text.includes(
                                normalize(keyword)
                            )
                        ) {
                            score += 1;
                        }
                    }
                );

                if (score > best.score) {
                    best = {
                        key,
                        score,
                        source: "inferred",
                    };
                }
            });

        return best;
    }


    function detectObjective(prompt) {
        // TOOLS-004 manual testing policy:
        // this utility generates valid functional data only.
        return "functional";
    }


    function objectiveLabel(value) {
        return "Functional validation";
    }


    function detectFieldType(field) {

        const normalized =
            normalize(field)
                .replace(/\s+/g, "_");

        for (const rule of fieldRules) {

            if (
                rule.match.some(
                    (token) =>
                        normalized.includes(token)
                )
            ) {
                return rule.type;
            }
        }

        return "text";
    }


    function extractPromptFields(prompt) {

        const text = normalize(prompt);

        const candidates = [
            "name",
            "first name",
            "last name",
            "email",
            "mobile",
            "phone",
            "dob",
            "date of birth",
            "address",
            "amount",
            "price",
            "quantity",
            "customer id",
            "employee id",
            "order id",
            "booking id",
            "transaction id",
            "account number",
            "status",
            "password",
            "username",
            "url",
            "currency",
            "room type",
            "check in",
            "check out",
        ];

        return candidates.filter(
            (field) =>
                text.includes(field)
        );
    }


    function extractSchemaFields() {

        const raw =
            byId("qa-testdata-schema")
                ?.value
                ?.trim()
            || "";

        if (!raw) {
            return [];
        }

        try {

            const parsed =
                JSON.parse(raw);

            if (
                parsed
                && typeof parsed === "object"
                && !Array.isArray(parsed)
            ) {

                if (
                    parsed.properties
                    && typeof parsed.properties
                        === "object"
                ) {
                    return Object.keys(
                        parsed.properties
                    );
                }

                return Object.keys(parsed);
            }

        } catch (_) {
            // Continue with text field parsing.
        }

        return raw
            .split(/[,\n]/)
            .map(
                (field) =>
                    field
                        .replace(
                            /["'{}\[\]:]/g,
                            ""
                        )
                        .trim()
            )
            .filter(Boolean)
            .slice(0, 30);
    }


    function inferFields(prompt, domainKey) {

        const schemaFields =
            extractSchemaFields();

        if (schemaFields.length) {
            return schemaFields;
        }

        const promptFields =
            extractPromptFields(prompt);

        if (promptFields.length) {
            return promptFields;
        }

        return [
            ...domainKnowledge[
                domainKey
            ].fields
        ];
    }


    /* ------------------------------------------------------
       SCENARIO DESIGN
       ------------------------------------------------------ */

    function buildScenarioPlan(
        fields,
        objective
    ) {

        const scenarios = [];

        fields.forEach((field) => {

            const type =
                detectFieldType(field);

            scenarios.push({
                field,
                type,
                scenario: "Valid",
                expected: "Accept",
                reason:
                    `Confirm ${field} accepts a normal valid ${type} value.`,
            });

            scenarios.push({
                field,
                type,
                scenario: "Invalid",
                expected: "Reject",
                reason:
                    `Confirm malformed ${field} input is rejected with clear validation.`,
            });

            scenarios.push({
                field,
                type,
                scenario: "Boundary",
                expected:
                    "Validate boundary",
                reason:
                    `Exercise minimum, maximum and near-limit behavior for ${field}.`,
            });

            if (
                objective === "security"
                || type === "text"
                || type === "name"
                || type === "id"
            ) {
                scenarios.push({
                    field,
                    type,
                    scenario: "Security",
                    expected:
                        "Reject / safely handle",
                    reason:
                        `Verify ${field} treats hostile-looking strings strictly as data.`,
                });
            }

            if (
                objective === "localization"
                || type === "name"
                || type === "address"
                || type === "text"
            ) {
                scenarios.push({
                    field,
                    type,
                    scenario: "Unicode",
                    expected:
                        "Accept if supported",
                    reason:
                        `Verify ${field} handles multilingual and multi-byte input correctly.`,
                });
            }

            scenarios.push({
                field,
                type,
                scenario: "Empty / Null",
                expected:
                    "Validate requirement",
                reason:
                    `Verify required/optional behavior when ${field} is empty or null.`,
            });
        });

        return scenarios;
    }


    function buildIdeas(
        fields,
        domain,
        objective
    ) {
        const ideas = [];

        ideas.push(
            "Generate realistic values matching the selected locale."
        );

        ideas.push(
            "Keep related fields internally consistent across each record."
        );

        if (
            fields.some(
                (field) =>
                    detectFieldType(field)
                    === "email"
            )
        ) {
            ideas.push(
                "Use syntactically valid synthetic email addresses."
            );
        }

        if (
            fields.some(
                (field) =>
                    detectFieldType(field)
                    === "mobile"
            )
        ) {
            ideas.push(
                "Use valid mobile-number formatting for the selected locale."
            );
        }

        if (
            fields.some(
                (field) =>
                    detectFieldType(field)
                    === "date"
            )
        ) {
            ideas.push(
                "Keep date relationships valid and chronologically consistent."
            );
        }

        if (
            fields.some(
                (field) =>
                    detectFieldType(field)
                    === "amount"
            )
        ) {
            ideas.push(
                "Generate positive functional monetary values with normal decimal precision."
            );
        }

        if (domain.key === "hotel") {
            ideas.push(
                "Ensure checkout dates are later than check-in dates."
            );
        }

        if (domain.key === "ecommerce") {
            ideas.push(
                "Keep quantity, unit price and total values logically consistent."
            );
        }

        if (
            domain.key === "payments"
            || domain.key === "banking"
        ) {
            ideas.push(
                "Use clearly synthetic non-production financial identifiers."
            );
        }

        return [
            ...new Set(ideas)
        ].slice(0, 8);
    }

    /* ------------------------------------------------------
       UI
       ------------------------------------------------------ */

    function updateSemanticStatus(
        domain,
        objective,
        fields
    ) {

        const domainNode =
            byId("qa-detected-domain");

        const intentNode =
            byId("qa-detected-intent");

        const confidenceNode =
            byId("qa-detected-confidence");

        if (domainNode) {
            domainNode.textContent =
                domainKnowledge[
                    domain.key
                ].label;
        }

        if (intentNode) {
            intentNode.textContent =
                objectiveLabel(objective);
        }

        if (confidenceNode) {

            if (
                domain.source
                === "preset"
            ) {
                confidenceNode.textContent =
                    "Preset";
            } else if (
                domain.score >= 2
            ) {
                confidenceNode.textContent =
                    "High";
            } else if (
                domain.score === 1
            ) {
                confidenceNode.textContent =
                    "Medium";
            } else {
                confidenceNode.textContent =
                    fields.length
                        ? "Field-aware"
                        : "General";
            }
        }
    }


    function renderIdeas(ideas) {

        const target =
            byId("qa-ai-idea-list");

        if (!target) {
            return;
        }

        target.innerHTML =
            ideas.map(
                (idea, index) => `
                    <article>
                        <span>${index + 1}</span>
                        <p>${escapeIdea(idea)}</p>
                    </article>
                `
            ).join("");
    }


    function escapeIdea(value) {

        const node =
            document.createElement(
                "div"
            );

        node.textContent =
            String(value);

        return node.innerHTML;
    }


    function analyzeSemanticPrompt() {

        const prompt =
            byId("qa-testdata-prompt")
                ?.value
            || "";

        const domain =
            detectDomain(prompt);

        const objective =
            detectObjective(prompt);

        const fields =
            inferFields(
                prompt,
                domain.key
            );

        const plan =
            buildScenarioPlan(
                fields,
                objective
            );

        const ideas =
            buildIdeas(
                fields,
                domain,
                objective
            );

        updateSemanticStatus(
            domain,
            objective,
            fields
        );

        renderIdeas(ideas);

        window.QAFoxSemanticQA = {
            domain,
            objective,
            fields,
            plan,
            ideas,
        };

        return window.QAFoxSemanticQA;
    }


    function updateSchemaSummary() {

        const fields =
            extractSchemaFields();

        const node =
            byId("qa-schema-summary");

        if (!node) {
            return;
        }

        if (!fields.length) {
            node.textContent =
                "No fields detected.";

            return;
        }

        node.textContent =
            `${fields.length} fields detected: `
            + fields
                .slice(0, 6)
                .join(", ")
            + (
                fields.length > 6
                    ? "…"
                    : ""
            );

        analyzeSemanticPrompt();
    }


    byId("qa-analyze-schema")
        ?.addEventListener(
            "click",
            updateSchemaSummary
        );


    byId("qa-refresh-ideas")
        ?.addEventListener(
            "click",
            analyzeSemanticPrompt
        );


    byId("qa-testdata-domain")
        ?.addEventListener(
            "change",
            analyzeSemanticPrompt
        );


    byId("qa-testdata-objective")
        ?.addEventListener(
            "change",
            analyzeSemanticPrompt
        );


    byId("qa-testdata-prompt")
        ?.addEventListener(
            "input",
            () => {

                window.clearTimeout(
                    window.__qaSemanticTimer
                );

                window.__qaSemanticTimer =
                    window.setTimeout(
                        analyzeSemanticPrompt,
                        250
                    );
            }
        );


    analyzeSemanticPrompt();

})();

