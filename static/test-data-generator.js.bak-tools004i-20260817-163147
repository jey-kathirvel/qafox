(() => {
    "use strict";

    /*
     * PATCH-QAFOX-TOOLS-004F
     *
     * AI Test Data Generator
     * Standalone manual QA utility.
     *
     * Policy:
     *   - synthetic data only
     *   - valid functional values only
     *   - no negative/security/boundary payloads
     *   - no dependency on uploaded projects
     */

    const $ = (
        selector,
        root = document
    ) => root.querySelector(
        selector
    );

    const $$ = (
        selector,
        root = document
    ) => Array.from(
        root.querySelectorAll(
            selector
        )
    );


    const tableBody =
        $("#qa-testdata-results");

    if (!tableBody) {
        return;
    }


    let currentRows = [];

    let activeGenerator =
        "generic";


    const generatorNames = {
        generic:
            "Functional",

        customer:
            "Customer",

        person:
            "Person",

        address:
            "Address",

        payment:
            "Payment",

        card:
            "Payment Card",

        hotel:
            "Hotel Booking",

        ecommerce:
            "E-commerce",

        employee:
            "Employee",

        product:
            "Product",

        travel:
            "Travel",
    };


    const firstNames = [
        "Aarav",
        "Aditya",
        "Arjun",
        "Diya",
        "Ishaan",
        "Kavya",
        "Meera",
        "Nila",
        "Priya",
        "Rahul",
        "Riya",
        "Sanjay",
        "Vikram",
    ];


    const lastNames = [
        "Anand",
        "Iyer",
        "Kumar",
        "Menon",
        "Nair",
        "Patel",
        "Rao",
        "Reddy",
        "Shah",
        "Sharma",
        "Singh",
        "Verma",
    ];


    const indianLocations = [
        {
            city: "Chennai",
            state: "Tamil Nadu",
            postal: "600040",
        },
        {
            city: "Madurai",
            state: "Tamil Nadu",
            postal: "625001",
        },
        {
            city: "Coimbatore",
            state: "Tamil Nadu",
            postal: "641001",
        },
        {
            city: "Theni",
            state: "Tamil Nadu",
            postal: "625531",
        },
        {
            city: "Bengaluru",
            state: "Karnataka",
            postal: "560001",
        },
        {
            city: "Hyderabad",
            state: "Telangana",
            postal: "500001",
        },
        {
            city: "Mumbai",
            state: "Maharashtra",
            postal: "400001",
        },
        {
            city: "Delhi",
            state: "Delhi",
            postal: "110001",
        },
    ];


    const roomTypes = [
        "Standard",
        "Deluxe",
        "Executive",
        "Double AC",
        "Double Non-AC",
        "Single Non-AC",
    ];


    const productNames = [
        "Wireless Keyboard",
        "USB-C Adapter",
        "Office Chair",
        "LED Monitor",
        "Travel Backpack",
        "Bluetooth Speaker",
        "Desk Lamp",
        "Laptop Stand",
    ];


    function randomItem(items) {
        return items[
            Math.floor(
                Math.random()
                * items.length
            )
        ];
    }


    function randomInt(
        min,
        max
    ) {
        return (
            Math.floor(
                Math.random()
                * (
                    max
                    - min
                    + 1
                )
            )
            + min
        );
    }


    function pad(
        value,
        length = 2
    ) {
        return String(value)
            .padStart(
                length,
                "0"
            );
    }


    function locale() {
        return (
            $("#qa-testdata-locale")
                ?.value
            || "en-IN"
        );
    }


    function count() {
        const input =
            $("#qa-testdata-count");

        let value =
            Number(
                input?.value
                || 10
            );

        if (
            !Number.isFinite(
                value
            )
        ) {
            value = 10;
        }

        value =
            Math.max(
                1,
                Math.min(
                    100,
                    Math.round(
                        value
                    )
                )
            );

        if (input) {
            input.value =
                String(value);
        }

        return value;
    }


    function uuid() {
        if (
            globalThis.crypto
            ?.randomUUID
        ) {
            return (
                globalThis.crypto
                    .randomUUID()
            );
        }

        return (
            "xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx"
        ).replace(
            /[xy]/g,
            (char) => {
                const value =
                    Math.random()
                    * 16
                    | 0;

                const resolved =
                    char === "x"
                        ? value
                        : (
                            value
                            & 0x3
                        )
                        | 0x8;

                return resolved
                    .toString(16);
            }
        );
    }


    function randomDate(
        startYear = 1980,
        endYear = 2005
    ) {
        const year =
            randomInt(
                startYear,
                endYear
            );

        const month =
            randomInt(
                1,
                12
            );

        const maxDay =
            new Date(
                year,
                month,
                0
            ).getDate();

        const day =
            randomInt(
                1,
                maxDay
            );

        return (
            `${year}-`
            + `${pad(month)}-`
            + `${pad(day)}`
        );
    }


    function futureDate(
        offsetMin = 1,
        offsetMax = 90
    ) {
        const date =
            new Date();

        date.setDate(
            date.getDate()
            + randomInt(
                offsetMin,
                offsetMax
            )
        );

        return date
            .toISOString()
            .slice(
                0,
                10
            );
    }


    function dateAfter(
        isoDate,
        minDays = 1,
        maxDays = 7
    ) {
        const date =
            new Date(
                `${isoDate}T00:00:00`
            );

        date.setDate(
            date.getDate()
            + randomInt(
                minDays,
                maxDays
            )
        );

        return date
            .toISOString()
            .slice(
                0,
                10
            );
    }


    function person() {
        const first =
            randomItem(
                firstNames
            );

        const last =
            randomItem(
                lastNames
            );

        const serial =
            randomInt(
                1000,
                999999
            );

        return {
            first_name:
                first,

            last_name:
                last,

            name:
                `${first} ${last}`,

            email:
                (
                    `${first}.${last}`
                    + `${serial}@example.test`
                ).toLowerCase(),

            mobile:
                `9${randomInt(
                    100000000,
                    999999999
                )}`,

            dob:
                randomDate(),
        };
    }


    function address() {
        const location =
            randomItem(
                indianLocations
            );

        return {
            address_line1:
                `${randomInt(
                    1,
                    999
                )}, `
                + `${randomItem([
                    "Lake View Road",
                    "Anna Nagar Main Road",
                    "Park Street",
                    "MG Road",
                    "Temple Street",
                    "Station Road",
                ])}`,

            city:
                location.city,

            state:
                location.state,

            postal_code:
                location.postal,

            country:
                "India",
        };
    }


    /*
     * Payment-card data is intentionally synthetic.
     * These are standard documentation/test numbers,
     * not real account credentials.
     */

    function cardData() {
        const visa =
            Math.random()
            < 0.5;

        return {
            card_brand:
                visa
                    ? "Visa"
                    : "Mastercard",

            card_number:
                visa
                    ? "4111111111111111"
                    : "5555555555554444",

            expiry_month:
                pad(
                    randomInt(
                        1,
                        12
                    )
                ),

            expiry_year:
                String(
                    new Date()
                        .getFullYear()
                    + randomInt(
                        2,
                        5
                    )
                ),

            cvv:
                String(
                    randomInt(
                        100,
                        999
                    )
                ),
        };
    }


    function detectGenerator() {
        const prompt =
            (
                $("#qa-testdata-prompt")
                    ?.value
                || ""
            ).toLowerCase();

        if (
            /hotel|booking|guest|room|check.?in|check.?out/.test(
                prompt
            )
        ) {
            return "hotel";
        }

        if (
            /visa|mastercard|credit card|debit card|card number|cvv/.test(
                prompt
            )
        ) {
            return "card";
        }

        if (
            /payment|transaction|merchant|amount|upi/.test(
                prompt
            )
        ) {
            return "payment";
        }

        if (
            /checkout|cart|product|order|ecommerce|e-commerce/.test(
                prompt
            )
        ) {
            return "ecommerce";
        }

        if (
            /employee|staff|department|hr/.test(
                prompt
            )
        ) {
            return "employee";
        }

        if (
            /travel|flight|trip|passenger/.test(
                prompt
            )
        ) {
            return "travel";
        }

        if (
            /address|postal|postcode|pincode|city|state/.test(
                prompt
            )
        ) {
            return "address";
        }

        if (
            /customer|registration|signup|name|email|mobile|dob/.test(
                prompt
            )
        ) {
            return "customer";
        }

        return "generic";
    }


    function buildRecord(
        generator
    ) {
        const p =
            person();

        const a =
            address();

        const id =
            uuid();

        if (
            generator
            === "customer"
        ) {
            return {
                customer_id:
                    `CUS-${id.slice(
                        0,
                        8
                    ).toUpperCase()}`,

                name:
                    p.name,

                email:
                    p.email,

                mobile:
                    p.mobile,

                dob:
                    p.dob,

                ...a,
            };
        }


        if (
            generator
            === "address"
        ) {
            return {
                name:
                    p.name,

                mobile:
                    p.mobile,

                ...a,
            };
        }


        if (
            generator
            === "card"
        ) {
            return {
                cardholder_name:
                    p.name,

                ...cardData(),

                billing_address:
                    `${a.address_line1}, `
                    + `${a.city}, `
                    + `${a.state} `
                    + `${a.postal_code}`,
            };
        }


        if (
            generator
            === "payment"
        ) {
            return {
                transaction_id:
                    `TXN-${id.slice(
                        0,
                        12
                    ).toUpperCase()}`,

                amount:
                    Number(
                        (
                            Math.random()
                            * 4900
                            + 100
                        ).toFixed(2)
                    ),

                currency:
                    "INR",

                payment_method:
                    randomItem([
                        "UPI",
                        "Card",
                        "Net Banking",
                    ]),

                merchant_id:
                    `MER-${randomInt(
                        10000,
                        99999
                    )}`,

                status:
                    "SUCCESS",
            };
        }


        if (
            generator
            === "hotel"
        ) {
            const checkIn =
                futureDate(
                    1,
                    45
                );

            const checkOut =
                dateAfter(
                    checkIn,
                    1,
                    7
                );

            return {
                booking_id:
                    `BKG-${id.slice(
                        0,
                        8
                    ).toUpperCase()}`,

                guest_name:
                    p.name,

                mobile:
                    p.mobile,

                email:
                    p.email,

                room_type:
                    randomItem(
                        roomTypes
                    ),

                check_in:
                    checkIn,

                check_out:
                    checkOut,

                guest_count:
                    randomInt(
                        1,
                        4
                    ),
            };
        }


        if (
            generator
            === "ecommerce"
        ) {
            const quantity =
                randomInt(
                    1,
                    5
                );

            const price =
                Number(
                    (
                        Math.random()
                        * 4500
                        + 100
                    ).toFixed(2)
                );

            return {
                order_id:
                    `ORD-${id.slice(
                        0,
                        8
                    ).toUpperCase()}`,

                customer_name:
                    p.name,

                product_name:
                    randomItem(
                        productNames
                    ),

                quantity,

                unit_price:
                    price,

                total_amount:
                    Number(
                        (
                            quantity
                            * price
                        ).toFixed(2)
                    ),

                shipping_address:
                    `${a.address_line1}, `
                    + `${a.city}, `
                    + `${a.state} `
                    + `${a.postal_code}`,
            };
        }


        if (
            generator
            === "employee"
        ) {
            return {
                employee_id:
                    `EMP-${randomInt(
                        10000,
                        99999
                    )}`,

                name:
                    p.name,

                email:
                    p.email,

                mobile:
                    p.mobile,

                department:
                    randomItem([
                        "Engineering",
                        "Quality Assurance",
                        "Finance",
                        "Operations",
                        "Human Resources",
                        "Sales",
                    ]),

                joining_date:
                    randomDate(
                        2018,
                        2026
                    ),
            };
        }


        if (
            generator
            === "travel"
        ) {
            const departure =
                futureDate(
                    3,
                    90
                );

            return {
                booking_reference:
                    `TRV-${id.slice(
                        0,
                        8
                    ).toUpperCase()}`,

                passenger_name:
                    p.name,

                email:
                    p.email,

                mobile:
                    p.mobile,

                origin:
                    randomItem([
                        "Chennai",
                        "Bengaluru",
                        "Mumbai",
                        "Delhi",
                        "Hyderabad",
                    ]),

                destination:
                    randomItem([
                        "Kochi",
                        "Goa",
                        "Pune",
                        "Jaipur",
                        "Madurai",
                    ]),

                departure_date:
                    departure,

                passenger_count:
                    randomInt(
                        1,
                        4
                    ),
            };
        }


        return {
            record_id:
                `QA-${id.slice(
                    0,
                    8
                ).toUpperCase()}`,

            name:
                p.name,

            email:
                p.email,

            mobile:
                p.mobile,

            ...a,
        };
    }


    function flattenRecord(
        record,
        index
    ) {
        return Object.entries(
            record
        ).map(
            ([field, value]) => ({
                id:
                    `${index + 1}-${field}`,

                field,

                scenario:
                    "Valid Functional",

                value:
                    String(
                        value
                    ),

                expected:
                    "Accept",

                record:
                    index + 1,

                synthetic:
                    true,
            })
        );
    }


    function escapeHtml(
        value
    ) {
        return String(
            value ?? ""
        )
            .replace(
                /&/g,
                "&amp;"
            )
            .replace(
                /</g,
                "&lt;"
            )
            .replace(
                />/g,
                "&gt;"
            )
            .replace(
                /"/g,
                "&quot;"
            )
            .replace(
                /'/g,
                "&#039;"
            );
    }


    function renderRows() {
        if (!tableBody) {
            return;
        }

        if (
            !currentRows.length
        ) {
            tableBody.innerHTML =
                `<tr>
                    <td colspan="5">
                        Generate valid functional test data to begin.
                    </td>
                </tr>`;

            return;
        }

        tableBody.innerHTML =
            currentRows
                .map(
                    (
                        row,
                        index
                    ) => `
                    <tr>
                        <td>
                            ${escapeHtml(
                                row.field
                            )}
                        </td>

                        <td>
                            <span class="qa-badge">
                                Valid Functional
                            </span>
                        </td>

                        <td>
                            <code>
                                ${escapeHtml(
                                    row.value
                                )}
                            </code>
                        </td>

                        <td>
                            Accept
                        </td>

                        <td>
                            <button
                                type="button"
                                class="qa-btn qa-btn-small"
                                data-copy-row="${index}"
                            >
                                Copy
                            </button>
                        </td>
                    </tr>
                `
                )
                .join("");
    }


    function buildRows() {
        activeGenerator =
            detectGenerator();

        const records =
            Array.from(
                {
                    length:
                        count(),
                },
                () =>
                    buildRecord(
                        activeGenerator
                    )
            );

        currentRows =
            records.flatMap(
                flattenRecord
            );

        renderRows();

        window.QAFoxTestData =
            window.QAFoxTestData
            || {};

        window.QAFoxTestData.records =
            records;

        window.QAFoxTestData.rows =
            currentRows;

        window.QAFoxTestData.generator =
            activeGenerator;

        window.QAFoxTestData.locale =
            locale();

        return records;
    }


    async function copyText(
        value
    ) {
        const text =
            String(
                value ?? ""
            );

        try {
            await navigator
                .clipboard
                .writeText(
                    text
                );

            toast(
                "Copied to clipboard"
            );

            return;
        } catch (_) {
            // fallback below
        }

        const textarea =
            document.createElement(
                "textarea"
            );

        textarea.value =
            text;

        textarea.style.position =
            "fixed";

        textarea.style.opacity =
            "0";

        document.body.appendChild(
            textarea
        );

        textarea.select();

        document.execCommand(
            "copy"
        );

        textarea.remove();

        toast(
            "Copied to clipboard"
        );
    }


    function toast(
        message
    ) {
        const target =
            $("#qa-testdata-toast")
            || $("#qa-testdata-status");

        if (target) {
            target.textContent =
                message;

            return;
        }

        console.info(
            "[QAFox Test Data]",
            message
        );
    }


    function download(
        filename,
        content,
        mime
    ) {
        const blob =
            new Blob(
                [content],
                {
                    type:
                        mime,
                }
            );

        const url =
            URL.createObjectURL(
                blob
            );

        const anchor =
            document.createElement(
                "a"
            );

        anchor.href =
            url;

        anchor.download =
            filename;

        document.body.appendChild(
            anchor
        );

        anchor.click();
        anchor.remove();

        setTimeout(
            () =>
                URL.revokeObjectURL(
                    url
                ),
            0
        );
    }


    function asCsv() {
        const records =
            window.QAFoxTestData
                ?.records
            || [];

        if (
            !records.length
        ) {
            return "";
        }

        const headers =
            [
                ...new Set(
                    records.flatMap(
                        (record) =>
                            Object.keys(
                                record
                            )
                    )
                ),
            ];

        const csvValue =
            (value) => {
                const text =
                    String(
                        value ?? ""
                    );

                return (
                    `"${text.replace(
                        /"/g,
                        '""'
                    )}"`
                );
            };

        return [
            headers
                .map(
                    csvValue
                )
                .join(","),

            ...records.map(
                (record) =>
                    headers
                        .map(
                            (header) =>
                                csvValue(
                                    record[
                                        header
                                    ]
                                )
                        )
                        .join(",")
            ),
        ].join("\n");
    }


    tableBody.addEventListener(
        "click",
        (event) => {
            const button =
                event.target.closest(
                    "[data-copy-row]"
                );

            if (!button) {
                return;
            }

            const index =
                Number(
                    button.dataset
                        .copyRow
                );

            const row =
                currentRows[
                    index
                ];

            if (row) {
                copyText(
                    row.value
                );
            }
        }
    );


    $("#qa-testdata-generate")
        ?.addEventListener(
            "click",
            () => {
                const records =
                    buildRows();

                toast(
                    `Generated ${
                        records.length
                    } valid ${
                        generatorNames[
                            activeGenerator
                        ]
                        || "functional"
                    } record(s)`
                );
            }
        );


    $("#qa-testdata-copy-all")
        ?.addEventListener(
            "click",
            () => {
                const records =
                    window.QAFoxTestData
                        ?.records
                    || [];

                if (
                    !records.length
                ) {
                    toast(
                        "Generate data first"
                    );

                    return;
                }

                copyText(
                    JSON.stringify(
                        records,
                        null,
                        2
                    )
                );
            }
        );


    $("#qa-testdata-export-json")
        ?.addEventListener(
            "click",
            () => {
                const records =
                    window.QAFoxTestData
                        ?.records
                    || [];

                if (
                    !records.length
                ) {
                    toast(
                        "Generate data first"
                    );

                    return;
                }

                download(
                    "qafox-valid-testdata.json",
                    JSON.stringify(
                        {
                            generator:
                                activeGenerator,

                            locale:
                                locale(),

                            generatedAt:
                                new Date()
                                    .toISOString(),

                            synthetic:
                                true,

                            dataQuality:
                                "valid",

                            objective:
                                "functional",

                            records,
                        },
                        null,
                        2
                    ),
                    "application/json"
                );
            }
        );


    $("#qa-testdata-export-csv")
        ?.addEventListener(
            "click",
            () => {
                const csv =
                    asCsv();

                if (!csv) {
                    toast(
                        "Generate data first"
                    );

                    return;
                }

                download(
                    "qafox-valid-testdata.csv",
                    csv,
                    "text/csv;charset=utf-8"
                );
            }
        );


    $("#qa-testdata-count")
        ?.addEventListener(
            "change",
            count
        );


    document.addEventListener(
        "click",
        (event) => {
            const quick =
                event.target.closest(
                    "[data-functional-prompt]"
                );

            if (!quick) {
                return;
            }

            const prompt =
                $("#qa-testdata-prompt");

            if (!prompt) {
                return;
            }

            prompt.value =
                quick.dataset
                    .functionalPrompt
                || "";

            prompt.dispatchEvent(
                new Event(
                    "input",
                    {
                        bubbles:
                            true,
                    }
                )
            );

            prompt.focus();
        }
    );


    /*
     * Expose a minimal bridge for the saved-dataset module.
     */

    window.QAFoxTestData =
        window.QAFoxTestData
        || {};

    window.QAFoxTestData.generate =
        buildRows;

    window.QAFoxTestData.getRecords =
        () => (
            window.QAFoxTestData
                ?.records
            || []
        );

    window.QAFoxTestData.getRows =
        () => (
            currentRows
        );


    renderRows();

})();


