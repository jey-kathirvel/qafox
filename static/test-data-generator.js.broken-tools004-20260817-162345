    /* ------------------------------------------------------
       UI
       ------------------------------------------------------ */

    function updateSemanticStatus(
        domain,
        objective,
        fields
    ) {

        const domainNode =
            byId("qa-detected-domain");

        const intentNode =
            byId("qa-detected-intent");

        const confidenceNode =
            byId("qa-detected-confidence");

        if (domainNode) {
            domainNode.textContent =
                domainKnowledge[
                    domain.key
                ].label;
        }

        if (intentNode) {
            intentNode.textContent =
                objectiveLabel(objective);
        }

        if (confidenceNode) {

            if (
                domain.source
                === "preset"
            ) {
                confidenceNode.textContent =
                    "Preset";
            } else if (
                domain.score >= 2
            ) {
                confidenceNode.textContent =
                    "High";
            } else if (
                domain.score === 1
            ) {
                confidenceNode.textContent =
                    "Medium";
            } else {
                confidenceNode.textContent =
                    fields.length
                        ? "Field-aware"
                        : "General";
            }
        }
    }


    function renderIdeas(ideas) {

        const target =
            byId("qa-ai-idea-list");

        if (!target) {
            return;
        }

        target.innerHTML =
            ideas.map(
                (idea, index) => `
                    <article>
                        <span>${index + 1}</span>
                        <p>${escapeIdea(idea)}</p>
                    </article>
                `
            ).join("");
    }


    function escapeIdea(value) {

        const node =
            document.createElement(
                "div"
            );

        node.textContent =
            String(value);

        return node.innerHTML;
    }


    function analyzeSemanticPrompt() {

        const prompt =
            byId("qa-testdata-prompt")
                ?.value
            || "";

        const domain =
            detectDomain(prompt);

        const objective =
            detectObjective(prompt);

        const fields =
            inferFields(
                prompt,
                domain.key
            );

        const plan =
            buildScenarioPlan(
                fields,
                objective
            );

        const ideas =
            buildIdeas(
                fields,
                domain,
                objective
            );

        updateSemanticStatus(
            domain,
            objective,
            fields
        );

        renderIdeas(ideas);

        window.QAFoxSemanticQA = {
            domain,
            objective,
            fields,
            plan,
            ideas,
        };

        return window.QAFoxSemanticQA;
    }


    function updateSchemaSummary() {

        const fields =
            extractSchemaFields();

        const node =
            byId("qa-schema-summary");

        if (!node) {
            return;
        }

        if (!fields.length) {
            node.textContent =
                "No fields detected.";

            return;
        }

        node.textContent =
            `${fields.length} fields detected: `
            + fields
                .slice(0, 6)
                .join(", ")
            + (
                fields.length > 6
                    ? "…"
                    : ""
            );

        analyzeSemanticPrompt();
    }


    byId("qa-analyze-schema")
        ?.addEventListener(
            "click",
            updateSchemaSummary
        );


    byId("qa-refresh-ideas")
        ?.addEventListener(
            "click",
            analyzeSemanticPrompt
        );


    byId("qa-testdata-domain")
        ?.addEventListener(
            "change",
            analyzeSemanticPrompt
        );


    byId("qa-testdata-objective")
        ?.addEventListener(
            "change",
            analyzeSemanticPrompt
        );


    byId("qa-testdata-prompt")
        ?.addEventListener(
            "input",
            () => {

                window.clearTimeout(
                    window.__qaSemanticTimer
                );

                window.__qaSemanticTimer =
                    window.setTimeout(
                        analyzeSemanticPrompt,
                        250
                    );
            }
        );


    analyzeSemanticPrompt();

})();

