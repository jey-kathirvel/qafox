    function normalize(text) {
        return String(text || "")
            .toLowerCase()
            .replace(/[^a-z0-9_ -]/g, " ")
            .replace(/\s+/g, " ")
            .trim();
    }


    function detectDomain(prompt) {

        const selected =
            byId("qa-testdata-domain")?.value
            || "auto";

        if (
            selected !== "auto"
            && domainKnowledge[selected]
        ) {
            return {
                key: selected,
                score: 100,
                source: "preset",
            };
        }

        const text = normalize(prompt);

        let best = {
            key: "general",
            score: 0,
            source: "inferred",
        };

        Object.entries(domainKnowledge)
            .forEach(([key, domain]) => {

                if (key === "general") {
                    return;
                }

                let score = 0;

                domain.keywords.forEach(
                    (keyword) => {

                        if (
                            text.includes(
                                normalize(keyword)
                            )
                        ) {
                            score += 1;
                        }
                    }
                );

                if (score > best.score) {
                    best = {
                        key,
                        score,
                        source: "inferred",
                    };
                }
            });

        return best;
    }


    function detectObjective(prompt) {
        // TOOLS-004 manual testing policy:
        // this utility generates valid functional data only.
        return "functional";
    }

        const text = normalize(prompt);

        if (
            /security|injection|xss|malicious|attack/.test(
                text
            )
        ) {
            return "security";
        }

        if (
            /boundary|min|max|limit|length/.test(
                text
            )
        ) {
            return "boundary";
        }

        if (
            /invalid|negative|reject|error/.test(
                text
            )
        ) {
            return "negative";
        }

        if (
            /unicode|localization|localisation|tamil|language/.test(
                text
            )
        ) {
            return "localization";
        }

        if (
            /api|json|endpoint|payload|integration/.test(
                text
            )
        ) {
            return "integration";
        }

        return "functional";
    }


    function objectiveLabel(value) {

        return {
            functional:
                "Functional validation",

            negative:
                "Negative testing",

            boundary:
                "Boundary testing",

            security:
                "Input security validation",

            integration:
                "API / Integration",

            localization:
                "Localization / Unicode",
        }[value] || "Synthetic data";
    }


    function detectFieldType(field) {

        const normalized =
            normalize(field)
                .replace(/\s+/g, "_");

        for (const rule of fieldRules) {

            if (
                rule.match.some(
                    (token) =>
                        normalized.includes(token)
                )
            ) {
                return rule.type;
            }
        }

        return "text";
    }


    function extractPromptFields(prompt) {

        const text = normalize(prompt);

        const candidates = [
            "name",
            "first name",
            "last name",
            "email",
            "mobile",
            "phone",
            "dob",
            "date of birth",
            "address",
            "amount",
            "price",
            "quantity",
            "customer id",
            "employee id",
            "order id",
            "booking id",
            "transaction id",
            "account number",
            "status",
            "password",
            "username",
            "url",
            "currency",
            "room type",
            "check in",
            "check out",
        ];

        return candidates.filter(
            (field) =>
                text.includes(field)
        );
    }


    function extractSchemaFields() {

        const raw =
            byId("qa-testdata-schema")
                ?.value
                ?.trim()
            || "";

        if (!raw) {
            return [];
        }

        try {

            const parsed =
                JSON.parse(raw);

            if (
                parsed
                && typeof parsed === "object"
                && !Array.isArray(parsed)
            ) {

                if (
                    parsed.properties
                    && typeof parsed.properties
                        === "object"
                ) {
                    return Object.keys(
                        parsed.properties
                    );
                }

                return Object.keys(parsed);
            }

        } catch (_) {
            // Continue with text field parsing.
        }

        return raw
            .split(/[,\n]/)
            .map(
                (field) =>
                    field
                        .replace(
                            /["'{}\[\]:]/g,
                            ""
                        )
                        .trim()
            )
            .filter(Boolean)
            .slice(0, 30);
    }


    function inferFields(prompt, domainKey) {

        const schemaFields =
            extractSchemaFields();

        if (schemaFields.length) {
            return schemaFields;
        }

        const promptFields =
            extractPromptFields(prompt);

        if (promptFields.length) {
            return promptFields;
        }

        return [
            ...domainKnowledge[
                domainKey
            ].fields
        ];
    }


    /* ------------------------------------------------------
       SCENARIO DESIGN
       ------------------------------------------------------ */

    function buildScenarioPlan(
        fields,
        objective
    ) {

        const scenarios = [];

        fields.forEach((field) => {

            const type =
                detectFieldType(field);

            scenarios.push({
                field,
                type,
                scenario: "Valid",
                expected: "Accept",
                reason:
                    `Confirm ${field} accepts a normal valid ${type} value.`,
            });

            scenarios.push({
                field,
                type,
                scenario: "Invalid",
                expected: "Reject",
                reason:
                    `Confirm malformed ${field} input is rejected with clear validation.`,
            });

            scenarios.push({
                field,
                type,
                scenario: "Boundary",
                expected:
                    "Validate boundary",
                reason:
                    `Exercise minimum, maximum and near-limit behavior for ${field}.`,
            });

            if (
                objective === "security"
                || type === "text"
                || type === "name"
                || type === "id"
            ) {
                scenarios.push({
                    field,
                    type,
                    scenario: "Security",
                    expected:
                        "Reject / safely handle",
                    reason:
                        `Verify ${field} treats hostile-looking strings strictly as data.`,
                });
            }

            if (
                objective === "localization"
                || type === "name"
                || type === "address"
                || type === "text"
            ) {
                scenarios.push({
                    field,
                    type,
                    scenario: "Unicode",
                    expected:
                        "Accept if supported",
                    reason:
                        `Verify ${field} handles multilingual and multi-byte input correctly.`,
                });
            }

            scenarios.push({
                field,
                type,
                scenario: "Empty / Null",
                expected:
                    "Validate requirement",
                reason:
                    `Verify required/optional behavior when ${field} is empty or null.`,
            });
        });

        return scenarios;
    }


