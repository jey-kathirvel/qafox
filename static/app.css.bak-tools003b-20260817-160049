/* ----------------------------------------------------------
   WORKFLOW
   ---------------------------------------------------------- */

.qa-workflow-percent {
    min-width: 54px;

    text-align: right;

    color: #c56200;

    font-size:
        calc(
            22px
            * var(--qa-font-scale,1)
        );

    font-weight: 900;
}

.qa-workflow-progress {
    height: 7px;

    margin:
        2px 18px 16px;

    overflow: hidden;

    border-radius: 999px;

    background:
        #e9edf3;
}

.qa-workflow-progress span {
    display: block;

    height: 100%;

    border-radius: inherit;

    background:
        linear-gradient(
            90deg,
            #ffb22d,
            #ff7b00
        );

    box-shadow:
        0 0 12px
        rgba(255,138,0,.28);
}

.qa-workflow-steps {
    padding:
        0 14px 16px;

    display: grid;

    grid-template-columns:
        repeat(5,1fr);

    gap: 8px;
}

.qa-workflow-step {
    min-height: 126px;

    padding: 13px;

    display: flex;
    flex-direction: column;
    gap: 9px;

    border:
        1px solid
        rgba(111,132,163,.11);

    border-radius: 13px;

    background:
        rgba(255,255,255,.45);
}

.qa-workflow-step:hover {
    border-color:
        rgba(255,138,0,.20);

    background:
        rgba(255,247,232,.58);
}

.qa-step-number {
    width: 28px;
    height: 28px;

    display: grid;
    place-items: center;

    border-radius: 9px;

    color: #627086;

    background: #edf1f5;

    font-size: 10px;
    font-weight: 900;
}

.qa-workflow-step.complete
.qa-step-number {
    color: #087647;
    background: var(--qa-green-soft);
}

.qa-workflow-step.current
.qa-step-number {
    color: #b75a00;
    background: #ffe7bf;
}

.qa-workflow-step.locked {
    opacity: .65;
}

.qa-workflow-step strong {
    display: block;

    font-size:
        calc(
            10px
            * var(--qa-font-scale,1)
        );
}

.qa-workflow-step small {
    display: block;

    margin-top: 4px;

    color: #778499;

    font-size:
        calc(
            8px
            * var(--qa-font-scale,1)
        );

    line-height: 1.45;
}


/* ----------------------------------------------------------
   SECURITY
   ---------------------------------------------------------- */

.qa-security-state {
    color: #087647;

    font-size:
        calc(
            10px
            * var(--qa-font-scale,1)
        );

    font-weight: 850;
}

.qa-security-grid {
    padding:
        8px 16px 17px;

    display: grid;

    grid-template-columns:
        repeat(4,1fr);

    gap: 9px;
}

.qa-security-grid > div {
    padding: 13px;

    border:
