    align-items: center;
    justify-content: space-between;
    gap: 20px;
}

.policy-actions {
    margin-top: 12px;

    display: flex;
    justify-content: flex-end;
    gap: 8px;
}


/* ==========================================================
   MESSAGE VISIBILITY
   ========================================================== */

.message {
    margin-bottom: 13px;

    padding: 11px 13px;

    border:
        1px solid
