        blur(19px)
        saturate(145%);

    backdrop-filter:
        blur(19px)
        saturate(145%);

    box-shadow:
        0 13px 34px
        rgba(35,55,85,.075),
        inset 0 1px 0
        rgba(255,255,255,.97);
}

.qa-card-heading {
    padding:
        17px 18px 10px;

    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
}

.qa-card-heading > div > span {
    color: #c36200;

    font-size:
        calc(
            9px
            * var(--qa-font-scale,1)
        );

    font-weight: 900;
    letter-spacing: .11em;
}

.qa-card-heading h2 {
    margin:
        4px 0 2px;

    font-size:
        calc(
            16px
            * var(--qa-font-scale,1)
        );
}

.qa-card-heading p {
    margin: 4px 0 0;

    color: #6c798e;

    font-size:
        calc(
            10px
            * var(--qa-font-scale,1)
        );
