}

.case-enable-check {
    grid-template-columns: 20px minmax(0, 1fr) !important;
    align-items: start;
    padding: 14px;
    border: 1px solid #ccebdc;
    border-radius: 12px;
    background: #f2fff9;
}

.case-enable-check input {
    width: 18px;
    height: 18px;
    margin: 1px 0 0;
    padding: 0;
