/* ==========================================================
   RESPONSIVE FINAL PASS
   ========================================================== */

@media (max-width: 1050px) {

    .project-grid {
        grid-template-columns:
            repeat(2,1fr);
    }

    .qa-public
    .toolkit
    .cards {
        grid-template-columns:
            repeat(2,1fr);
    }

    .qa-public .hero {
        grid-template-columns: 1fr;
    }

    .qubi-card {
        min-height: 240px;
    }
}

@media (max-width: 850px) {

    .upload-shell,
    .auth-shell {
        grid-template-columns: 1fr;
    }

    .projects-heading {
        align-items: flex-start;
        flex-direction: column;
    }

    .auth-shell {
        min-height: auto;
    }

    .login-qubi {
        font-size: 60px;
    }
}

@media (max-width: 620px) {

    .projects-shell,
    .upload-shell,
    .policy-shell,
    .auth-shell {
        width:
            calc(100% - 16px);

        margin-top: 16px;
    }

    .project-grid,
    .qa-public
    .toolkit
    .cards,
    .policy-grid {
        grid-template-columns: 1fr;
    }

    .qa-public .hero {
        width:
            calc(100% - 16px);

        margin-top: 16px;

        padding:
            28px 18px;

        border-radius: 20px;
    }

    .qa-public .hero h1 {
        font-size:
            clamp(
                2.8rem,
                16vw,
                4.3rem
            );
    }

    .qa-public .toolkit {
        width:
            calc(100% - 16px);

        margin-bottom: 35px;
    }

    .hero-actions {
        display: grid;

        grid-template-columns: 1fr;
    }

    .hero-actions a {
        width: 100%;
        justify-content: center;
    }

    .trust-row {
        display: grid;

        grid-template-columns: 1fr;
    }

    .auth-art,
    .auth-card {
        padding: 20px;

        border-radius: 18px;
    }

    .auth-art h1 {
        font-size:
            2.4rem;
    }

    .auth-links.split {
        align-items: center;
        flex-direction: column;
    }

    .policy-contact,
    .policy-actions {
        align-items: stretch;
        flex-direction: column;
    }

    .policy-actions a,
    .policy-contact a {
        width: 100%;
        justify-content: center;
        text-align: center;
    }
}


/* ==========================================================
   LARGE FONT FINAL PASS
   ========================================================== */

html[data-qa-font-size="large"]
.project-grid {
    grid-template-columns:
        repeat(2,1fr);
}

