    border:
        1px solid
        rgba(255,255,255,.82);

    border-radius: 10px;

    color: #fff;

    background:
        rgba(15,27,51,.92);

    box-shadow:
        0 12px 28px
        rgba(15,27,51,.20);

    font-size: 10px;
    font-weight: 780;

    opacity: 0;

    transform:
        translateY(8px);

    pointer-events: none;

    transition:
        opacity .16s ease,
        transform .16s ease;
}

.qa-testdata-toast.is-visible {
    opacity: 1;

    transform:
        translateY(0);
}


/* ----------------------------------------------------------
   LARGE FONT
   ---------------------------------------------------------- */

html[data-qa-font-size="large"]
.qa-testdata-layout {
    grid-template-columns:
        390px minmax(0,1fr);
}

html[data-qa-font-size="large"]
.qa-testdata-capabilities {
    grid-template-columns:
        repeat(3,1fr);
}


/* ----------------------------------------------------------
   RESPONSIVE
   ---------------------------------------------------------- */

@media (max-width: 1180px) {

    .qa-testdata-layout {
        grid-template-columns:
            310px
            minmax(0,1fr);
    }

    .qa-testdata-capabilities {
        grid-template-columns:
            repeat(3,1fr);
    }

}

@media (max-width: 900px) {

    .qa-testdata-heading {
        align-items: flex-start;
        flex-direction: column;
    }

    .qa-testdata-heading-badge {
        width: 100%;
    }

    .qa-testdata-layout,
    html[data-qa-font-size="large"]
    .qa-testdata-layout {
        grid-template-columns: 1fr;
    }

    .qa-testdata-control-panel {
        position: static;
    }

}

@media (max-width: 620px) {

    .qa-testdata-studio {
        width:
            calc(100% - 16px);

        margin-top: 16px;
    }

    .qa-generator-grid {
        grid-template-columns:
            repeat(2,1fr);
    }

    .qa-testdata-form-grid {
        grid-template-columns: 1fr;
    }

    .qa-testdata-form-grid
    label:last-child {
        grid-column: auto;
    }

    .qa-testdata-results-head {
        align-items: flex-start;
        flex-direction: column;
    }

    .qa-testdata-result-actions {
        width: 100%;
    }

    .qa-testdata-result-actions
    button {
        flex: 1;
    }

    .qa-testdata-footer {
        align-items: flex-start;
        flex-direction: column;
    }

    .qa-testdata-capabilities,
    html[data-qa-font-size="large"]
    .qa-testdata-capabilities {
        grid-template-columns: 1fr;
    }

}

/* END PATCH-QAFOX-TOOLS-001 */

/* ==========================================================
   PATCH-QAFOX-TOOLS-002
   SEMANTIC QA INTELLIGENCE
   ========================================================== */

.qa-semantic-status {
    margin-top: 10px;

    display: grid;

    grid-template-columns:
        repeat(3,1fr);

    gap: 6px;
}

.qa-semantic-status > div {
    min-width: 0;

    padding: 9px;

    border:
        1px solid
        rgba(115,87,232,.10);

    border-radius: 9px;

    background:
        linear-gradient(
            145deg,
            rgba(242,238,255,.72),
            rgba(255,255,255,.62)
        );
}

.qa-semantic-status span {
    display: block;

    color: #887fa4;

    font-size:
        calc(
            6px
            * var(--qa-font-scale,1)
        );

    font-weight: 900;

    letter-spacing: .07em;
}

.qa-semantic-status strong {
    display: block;

    margin-top: 3px;

    overflow: hidden;

    color: #5d49b6;

    font-size:
        calc(
            8px
            * var(--qa-font-scale,1)
        );

    text-overflow: ellipsis;

    white-space: nowrap;
}


.qa-semantic-options {
    display: grid;

    grid-template-columns:
        1fr 1fr;

    gap: 7px;
}

.qa-semantic-options label {
    display: grid;

    gap: 5px;

    color: #4d5a70;

    font-size:
        calc(
            8px
            * var(--qa-font-scale,1)
        );

    font-weight: 760;
}

.qa-semantic-options select {
    width: 100%;

    min-height: 38px;

    font-size:
        calc(
            9px
            * var(--qa-font-scale,1)
        );
}


.qa-schema-panel {
    margin:
        12px 0 4px;

    border:
        1px solid
        rgba(111,132,163,.11);

    border-radius: 10px;

    background:
        rgba(248,250,253,.54);
}

.qa-schema-panel summary {
    min-height: 39px;

    padding: 0 10px;

    display: flex;

    align-items: center;

    gap: 7px;

    cursor: pointer;

    color: #4f5c70;

    font-size:
        calc(
            8px
            * var(--qa-font-scale,1)
        );

    font-weight: 820;

    list-style: none;
}

.qa-schema-panel summary::-webkit-details-marker {
    display: none;
}

.qa-schema-panel summary > span {
    color: #7057d8;
}

.qa-schema-panel summary small {
    margin-left: auto;

    padding: 3px 6px;

    border-radius: 999px;

    color: #6b57bf;

    background: #eee9ff;

    font-size: 7px;
}

.qa-schema-body {
    padding:
        0 10px 10px;
}

.qa-schema-body p {
    margin:
        0 0 7px;

    color: #7a8698;

    font-size:
        calc(
            7px
            * var(--qa-font-scale,1)
        );

    line-height: 1.45;
}

.qa-schema-body textarea {
    width: 100%;

    resize: vertical;

    font-family:
        ui-monospace,
        SFMono-Regular,
        Menlo,
        Monaco,
        Consolas,
        monospace;

    font-size:
        calc(
            8px
            * var(--qa-font-scale,1)
        );
}

.qa-schema-actions {
    margin-top: 7px;

    display: flex;

    align-items: center;

    gap: 8px;
}

.qa-schema-actions button {
    min-height: 31px;

    padding:
        0 9px;

    font-size:
        calc(
            8px
            * var(--qa-font-scale,1)
        );
}

.qa-schema-actions span {
    min-width: 0;

    color: #748196;

    font-size:
        calc(
            7px
            * var(--qa-font-scale,1)
        );

    overflow: hidden;

    text-overflow: ellipsis;

    white-space: nowrap;
}


.qa-ai-ideas {
    margin:
        10px 13px 0;

    border:
        1px solid
        rgba(255,138,0,.11);

    border-radius: 12px;

    background:
        linear-gradient(
            145deg,
            rgba(255,248,236,.68),
            rgba(255,255,255,.55)
        );
}

.qa-ai-ideas-head {
    padding: 10px;

    display: flex;

    align-items: center;

    justify-content:
        space-between;

    gap: 10px;

    border-bottom:
        1px solid
        rgba(255,138,0,.08);
}

.qa-ai-ideas-head > div {
    display: flex;

    align-items: center;

    gap: 8px;
}

.qa-ai-ideas-head > div > span {
    width: 30px;
    height: 30px;

    display: grid;

    place-items: center;

    flex: 0 0 auto;

    border-radius: 8px;

    color: #b65b00;

    background: #fff0d7;
}

.qa-ai-ideas-head strong,
.qa-ai-ideas-head small {
    display: block;
}

.qa-ai-ideas-head strong {
    font-size:
        calc(
            9px
            * var(--qa-font-scale,1)
        );
}

.qa-ai-ideas-head small {
    margin-top: 2px;

    color: #817766;

    font-size:
        calc(
            7px
            * var(--qa-font-scale,1)
        );
}

.qa-ai-ideas-head button {
    min-height: 31px;

    font-size:
        calc(
            8px
            * var(--qa-font-scale,1)
        );
}

.qa-ai-idea-list {
    padding: 8px;

    display: grid;

    grid-template-columns:
        repeat(2,minmax(0,1fr));

    gap: 6px;
}

.qa-ai-idea-list article {
    min-width: 0;

    padding: 8px;

    display: flex;

    align-items: flex-start;

    gap: 7px;

    border:
        1px solid
        rgba(111,132,163,.08);

    border-radius: 8px;

    background:
        rgba(255,255,255,.56);
}

.qa-ai-idea-list article > span {
    width: 21px;
    height: 21px;

    display: grid;

    place-items: center;

    flex: 0 0 auto;

    border-radius: 6px;

    color: #b45a00;

    background: #fff1da;

    font-size: 7px;

    font-weight: 900;
}

.qa-ai-idea-list p {
    margin: 1px 0 0;

    color: #59677b;

    font-size:
        calc(
            8px
            * var(--qa-font-scale,1)
        );

    line-height: 1.42;
}


@media (max-width: 620px) {

    .qa-semantic-status {
        grid-template-columns: 1fr;
    }

    .qa-semantic-options {
        grid-template-columns: 1fr;
    }

    .qa-ai-ideas-head {
        align-items: flex-start;

        flex-direction: column;
    }

    .qa-ai-idea-list {
        grid-template-columns: 1fr;
    }

}

/* END PATCH-QAFOX-TOOLS-002 */

/* ==========================================================
   PATCH-QAFOX-TOOLS-003A
   SAVED DATASETS
   ========================================================== */

.qa-dataset-toolbar {
    padding: 13px 15px;

    display: flex;
    align-items: flex-end;
    justify-content: space-between;

    gap: 12px;

    border-bottom:
        1px solid
        rgba(111,132,163,.10);

    background:
        rgba(249,250,253,.48);
}

.qa-dataset-name-area {
    flex: 1;

    display: grid;

    grid-template-columns:
        minmax(200px,1fr)
        minmax(180px,.8fr);

    gap: 8px;
}

.qa-dataset-name-area label {
    display: grid;

    gap: 5px;

    color: #4e5b70;

    font-size:
        calc(
            8px
            * var(--qa-font-scale,1)
        );

    font-weight: 800;
}

.qa-dataset-name-area input,
.qa-dataset-name-area select {
    width: 100%;

    min-height: 39px;
}

.qa-dataset-toolbar-actions {
    display: flex;

    gap: 7px;
}

.qa-dataset-toolbar-actions button {
    min-height: 39px;
}


.qa-saved-datasets {
    margin:
        11px 13px 0;

    border:
        1px solid
        rgba(111,132,163,.10);

    border-radius: 11px;

    background:
        rgba(248,250,252,.55);
}

.qa-saved-datasets summary {
    min-height: 41px;

    padding: 0 11px;

    display: flex;

    align-items: center;

    gap: 8px;

    cursor: pointer;

    list-style: none;

    color: #4f5d73;

    font-size:
        calc(
            9px
            * var(--qa-font-scale,1)
        );

    font-weight: 820;
}

.qa-saved-datasets summary::-webkit-details-marker {
    display: none;
}

.qa-saved-datasets summary > span {
    color: #6850ca;
}

.qa-saved-datasets summary small {
    margin-left: auto;

    min-width: 23px;

    padding: 3px 7px;

    border-radius: 999px;

    color: #614cbb;

    background: #eee9ff;

    text-align: center;
}

.qa-saved-dataset-list {
    padding:
        0 8px 8px;

    display: grid;

    gap: 6px;
}

.qa-saved-dataset-card {
    padding: 9px;

    display: flex;

    align-items: center;

    justify-content:
        space-between;

    gap: 10px;

    border:
        1px solid
        rgba(111,132,163,.08);

    border-radius: 9px;

    background:
        rgba(255,255,255,.63);
}

.qa-saved-dataset-card > div:first-child {
    min-width: 0;

    display: flex;

    flex-direction: column;
}

.qa-saved-dataset-card strong {
    overflow: hidden;

    font-size:
        calc(
            9px
            * var(--qa-font-scale,1)
        );

    text-overflow: ellipsis;

    white-space: nowrap;
}

.qa-saved-dataset-card small {
    margin-top: 3px;

    color: #778399;

    font-size:
        calc(
            7px
            * var(--qa-font-scale,1)
        );
}

.qa-saved-dataset-card > div:last-child {
    display: flex;

    gap: 5px;
}

.qa-saved-dataset-card button {
    min-height: 30px;

    padding:
        0 8px;

    font-size:
        calc(
            7px
            * var(--qa-font-scale,1)
        );
}

.qa-dataset-delete {
    border:
        1px solid
        rgba(239,68,68,.12) !important;

    border-radius:
        8px !important;

    color:
        #b83a3a !important;

    background:
        #fff0f0 !important;

    box-shadow:
        none !important;
}

.qa-saved-dataset-empty {
    padding: 18px;

    color: #7c8799;

    text-align: center;

    font-size: 8px;
}

.qa-data-regenerate {
    width: 31px;
    height: 31px;

    margin-left: 4px;

    padding: 0 !important;

    display: inline-grid;

    place-items: center;

    border:
        1px solid
        rgba(111,132,163,.12) !important;

    border-radius:
        8px !important;

    color:
        #536177 !important;

    background:
        #f6f8fb !important;

    box-shadow:
        none !important;
}


@media (max-width: 760px) {

    .qa-dataset-toolbar {
        align-items: stretch;

        flex-direction: column;
    }

    .qa-dataset-name-area {
        grid-template-columns: 1fr;
    }

    .qa-dataset-toolbar-actions {
        width: 100%;
    }

    .qa-dataset-toolbar-actions
    button {
        flex: 1;
    }

    .qa-saved-dataset-card {
        align-items: flex-start;

        flex-direction: column;
    }

}

/* END PATCH-QAFOX-TOOLS-003A */
