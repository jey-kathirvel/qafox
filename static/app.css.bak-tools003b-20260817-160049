    }

    .public-api-callout {
        align-items: flex-start;
        flex-direction: column;
    }
}

@media (max-width: 620px) {

    .public-api-support {
        width: min(100% - 18px, 1180px);
        margin: 18px auto 34px;
        padding: 17px;
        border-radius: 20px;
    }

    .public-api-support-heading h2 {
        font-size: 2rem;
    }

    .public-api-quick-grid {
        grid-template-columns: 1fr;
    }

    .public-api-quick-grid article {
        min-height: 0;
    }

    .public-api-frame-head {
        align-items: stretch;
        flex-direction: column;
    }

    .public-api-frame-toggle {
        width: 100%;
    }

    .public-api-frame {
        height: 620px;
    }

    .public-api-actions {
        width: 100%;
        flex-direction: column;
    }

    .public-api-actions a {
        width: 100%;
        text-align: center;
    }
}

/* BEGIN PATCH-QAFOX-GLASS-001
   ============================================================
   QAFox Enterprise Glass Design System

   Visual direction:
   - enterprise SaaS / engineering console
   - bright neutral glass surfaces
   - navy typography
   - saffron/orange primary actions
   - restrained semantic status colors
   - high readability
   ============================================================ */

:root {
    /* Brand */
    --qa-saffron: #ff8a00;
    --qa-saffron-strong: #f17600;
    --qa-saffron-soft: #fff3df;
    --qa-saffron-pale: #fff8ed;

    --qa-navy: #0f1b33;
    --qa-navy-2: #1e2a44;
    --qa-text: #18243b;
    --qa-text-soft: #536078;
    --qa-muted: #7b879d;

    /* Semantic */
    --qa-green: #12a96b;
    --qa-green-soft: #e7f9f1;
    --qa-red: #ef4444;
    --qa-red-soft: #fff0f0;
    --qa-amber: #e99a00;
    --qa-amber-soft: #fff6df;
    --qa-blue: #3478f6;
    --qa-blue-soft: #edf4ff;
    --qa-purple: #7357e8;
    --qa-purple-soft: #f1edff;

    /* Surfaces */
    --qa-bg: #edf2f8;
    --qa-glass: rgba(255, 255, 255, .70);
    --qa-glass-strong: rgba(255, 255, 255, .86);
    --qa-glass-soft: rgba(255, 255, 255, .54);
    --qa-line: rgba(118, 139, 170, .18);
    --qa-line-strong: rgba(104, 127, 160, .26);

    /* Shadow */
    --qa-shadow-sm:
        0 4px 14px rgba(35, 55, 85, .06);

    --qa-shadow:
        0 14px 38px rgba(35, 55, 85, .09);

    --qa-shadow-lg:
        0 26px 70px rgba(30, 48, 76, .13);

    --qa-shadow-saffron:
        0 10px 24px rgba(255, 138, 0, .25);

    /* Shape */
    --qa-radius-sm: 10px;
    --qa-radius: 14px;
    --qa-radius-lg: 20px;
    --qa-radius-xl: 26px;

    /* Compatibility with previous tokens */
    --navy: var(--qa-navy);
    --orange: var(--qa-saffron);
    --coral: #ff5a36;
    --violet: var(--qa-purple);
    --purple-dark: var(--qa-navy);
    --green: var(--qa-green);
    --background: var(--qa-bg);
    --muted: var(--qa-muted);
    --line: var(--qa-line);
}


/* ============================================================
   PAGE CANVAS
   ============================================================ */

html {
    background: var(--qa-bg);
}

body {
    min-height: 100vh;
    color: var(--qa-text);
    background:
        radial-gradient(
            circle at 7% 4%,
            rgba(255, 174, 61, .15),
            transparent 25rem
        ),
        radial-gradient(
            circle at 92% 7%,
            rgba(104, 143, 255, .15),
            transparent 30rem
        ),
        radial-gradient(
            circle at 62% 90%,
            rgba(133, 108, 238, .10),
            transparent 32rem
        ),
        linear-gradient(
            135deg,
            #f5f7fb 0%,
            #edf2f8 48%,
            #f8fafc 100%
        );
    background-attachment: fixed;
}

body::before {
    content: "";
    position: fixed;
    inset: 0;
    z-index: -2;
    pointer-events: none;
    background-image:
        linear-gradient(
            rgba(255,255,255,.18) 1px,
            transparent 1px
        ),
        linear-gradient(
            90deg,
            rgba(255,255,255,.14) 1px,
            transparent 1px
        );
    background-size: 38px 38px;
    mask-image:
        linear-gradient(
            to bottom,
            rgba(0,0,0,.45),
            transparent 72%
        );
}

::selection {
    color: var(--qa-navy);
    background: rgba(255, 176, 52, .32);
}


/* ============================================================
   TYPOGRAPHY
   ============================================================ */

h1,
h2,
h3,
h4,
h5,
h6,
strong,
b {
    color: var(--qa-navy);
}

h1,
h2,
h3 {
    letter-spacing: -.025em;
}

p,
small,
.help-text,
.muted,
.subtitle,
.description {
    color: var(--qa-text-soft);
}

code,
pre,
.endpoint-path,
.http-path,
.mono {
    font-family:
        "SFMono-Regular",
        Consolas,
        "Liberation Mono",
        Menlo,
        monospace;
}


/* ============================================================
   TOP BAR — FLOATING GLASS
   ============================================================ */

.topbar {
    min-height: 70px;
    width: calc(100% - 28px);
    margin: 12px auto 0;
    padding-left: clamp(18px, 4vw, 44px);
    padding-right: clamp(18px, 4vw, 44px);

    border: 1px solid rgba(255, 255, 255, .72);
    border-bottom-color: var(--qa-line);
    border-radius: var(--qa-radius-lg);

    background:
        linear-gradient(
            135deg,
            rgba(255,255,255,.88),
            rgba(255,255,255,.65)
        );

    -webkit-backdrop-filter: blur(22px) saturate(150%);
    backdrop-filter: blur(22px) saturate(150%);

    box-shadow:
        0 10px 32px rgba(38, 53, 78, .08),
        inset 0 1px 0 rgba(255,255,255,.9);
}

.brand {
    color: var(--qa-navy);
    font-weight: 850;
}

.brand strong span {
    color: var(--qa-saffron);
}

.fox-logo {
    filter:
        drop-shadow(
            0 6px 9px rgba(255, 138, 0, .18)
        );
}

.site-nav-link {
    color: #44516a;
    transition:
        background .18s ease,
        color .18s ease,
        transform .18s ease;
}

.site-nav-link:hover {
    color: var(--qa-saffron-strong);
    background: rgba(255, 248, 237, .9);
}

.site-nav-link.is-active {
    color: #d86d00;
    background:
        linear-gradient(
            135deg,
            #fff5e7,
            rgba(255,255,255,.8)
        );
    box-shadow:
        inset 0 0 0 1px rgba(255,138,0,.10);
}

.site-nav-link[data-nav-logout="true"] {
    color: var(--qa-red);
}


/* ============================================================
   USER / PROFILE CHIP
   ============================================================ */

.user-chip {
    padding: 5px 9px 5px 5px;
    border: 1px solid var(--qa-line);
    border-radius: 14px;
    background: rgba(255,255,255,.58);
}

.user-chip > span {
    color: #a95400;
    background:
        linear-gradient(
            145deg,
            #fff2d9,
            #ffd28f
        );
    border: 1px solid rgba(255,138,0,.20);
    box-shadow:
        inset 0 1px 0 rgba(255,255,255,.9);
}


/* ============================================================
   GLASS SURFACE PRIMITIVES
   ============================================================ */

.qubi-card,
.cards article,
.active-card,
.auth-card,
.auth-panel,
.welcome-panel,
.project-card,
.project-panel,
.dashboard-panel,
.dashboard-card,
.stat-card,
.metric-card,
.summary-card,
.report-card,
.execution-card,
.inventory-card,
.test-case-card,
.configuration-card,
.plan-card,
.result-card,
.panel,
.card,
.upload-shell,
.api-upload-guidance,
.public-api-support,
.public-api-frame-card,
.pwa-install-hint {
    border: 1px solid rgba(255,255,255,.72);
    outline: 1px solid rgba(107,127,157,.10);

    background:
        linear-gradient(
            145deg,
            rgba(255,255,255,.82),
            rgba(255,255,255,.59)
        );

    -webkit-backdrop-filter:
        blur(18px) saturate(145%);
    backdrop-filter:
        blur(18px) saturate(145%);

    box-shadow:
        var(--qa-shadow),
        inset 0 1px 0 rgba(255,255,255,.92);
}

.cards article,
.project-card,
.dashboard-card,
.stat-card,
.metric-card,
.summary-card,
.report-card,
.execution-card,
.inventory-card,
.test-case-card,
.configuration-card,
.plan-card,
.result-card,
.panel,
.card {
    border-radius: var(--qa-radius-lg);
}


/* ============================================================
   PUBLIC HERO — LIGHT ENTERPRISE GLASS
   ============================================================ */

.hero {
    color: var(--qa-navy);

    border:
        1px solid rgba(255,255,255,.78);

    background:
        radial-gradient(
            circle at 88% 5%,
            rgba(255, 168, 46, .17),
            transparent 27%
        ),
        radial-gradient(
            circle at 8% 95%,
            rgba(86, 122, 240, .10),
            transparent 32%
        ),
        linear-gradient(
            145deg,
            rgba(255,255,255,.88),
            rgba(255,255,255,.62)
        );

    -webkit-backdrop-filter:
        blur(24px) saturate(150%);
    backdrop-filter:
        blur(24px) saturate(150%);

    box-shadow:
        var(--qa-shadow-lg),
        inset 0 1px 0 rgba(255,255,255,.95);
}

.hero h1,
.auth-art h1 {
    color: var(--qa-navy);
}

.hero h1 em {
    color: var(--qa-saffron);
}

.hero p,
.auth-art p {
    color: var(--qa-text-soft);
}

.hero .pill {
    color: #b85e00;
    background: var(--qa-saffron-soft);
    border: 1px solid rgba(255,138,0,.13);
}

.trust-row {
    color: #55647d;
}

.qubi-card {
    color: var(--qa-navy);
}

.qubi-card small {
    color: var(--qa-muted);
}

.bubble {
    color: #9f5100;
    background: var(--qa-saffron-pale);
    border: 1px solid rgba(255,138,0,.18);
}


/* ============================================================
   SECTION LABELS / PILLS
   ============================================================ */

.pill,
.pill.dark,
.section-heading span,
.dashboard-header > div > span,
.welcome-panel > span,
.auth-kicker {
    color: #c26300;
    background: rgba(255, 244, 225, .88);
    border: 1px solid rgba(255,138,0,.14);
}

.pill {
    box-shadow:
        inset 0 1px 0 rgba(255,255,255,.88);
}


/* ============================================================
   PRIMARY ACTIONS — SAFFRON
   ============================================================ */

.primary-button,
button.primary-button,
input[type="submit"],
button[type="submit"],
.action-primary,
.btn-primary {
    color: #fff !important;

    border:
        1px solid rgba(224, 108, 0, .18);

    background:
        linear-gradient(
            135deg,
            #ffac24 0%,
            var(--qa-saffron) 48%,
            #ff7200 100%
        ) !important;

    box-shadow:
        var(--qa-shadow-saffron),
        inset 0 1px 0 rgba(255,255,255,.38);

    text-shadow:
        0 1px 1px rgba(119,50,0,.14);

    transition:
        transform .16s ease,
        box-shadow .16s ease,
        filter .16s ease;
}

.primary-button:hover,
button.primary-button:hover,
input[type="submit"]:hover,
button[type="submit"]:hover,
.action-primary:hover,
.btn-primary:hover {
    transform: translateY(-1px);
    filter: saturate(108%) brightness(1.02);
    box-shadow:
        0 13px 28px rgba(255,138,0,.31),
        inset 0 1px 0 rgba(255,255,255,.42);
}

.primary-button:active,
button.primary-button:active,
.action-primary:active,
.btn-primary:active {
    transform: translateY(0);
}


/* ============================================================
   SECONDARY / OUTLINE BUTTONS
   ============================================================ */

.outline-button,
.secondary-button,
button:not(.primary-button):not(.nav-toggle):not(.nav-close) {
    color: var(--qa-navy);

    border:
        1px solid rgba(104,126,157,.20);

    background:
        linear-gradient(
            145deg,
            rgba(255,255,255,.82),
            rgba(255,255,255,.58)
        );

    box-shadow:
        0 4px 12px rgba(35,55,85,.05),
        inset 0 1px 0 rgba(255,255,255,.86);

    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
}

.outline-button:hover,
.secondary-button:hover {
    color: #cc6700;
    border-color: rgba(255,138,0,.28);
    background: rgba(255,248,237,.86);
}


/* ============================================================
   PWA ACTION
   ============================================================ */

.pwa-install-button {
    color: #c66300;
    border-color: rgba(255,138,0,.20);
    background: var(--qa-saffron-soft);
}

.pwa-install-hint button {
    color: white;
    background:
        linear-gradient(
            135deg,
            #ffa51c,
            #ff7900
        );
}


/* ============================================================
   FORMS
   ============================================================ */

input,
select,
textarea {
    color: var(--qa-navy);

    border:
        1px solid rgba(111,132,163,.22);

    border-radius: 12px;

    background:
        rgba(255,255,255,.70);

    box-shadow:
        inset 0 1px 2px rgba(30,48,76,.025),
        0 1px 0 rgba(255,255,255,.75);

    transition:
        border-color .16s ease,
        box-shadow .16s ease,
        background .16s ease;
}

input:hover,
select:hover,
textarea:hover {
    border-color:
        rgba(104,126,157,.36);
}

input:focus,
select:focus,
textarea:focus {
    outline: none;

    border-color:
        rgba(255,138,0,.64);

    background:
        rgba(255,255,255,.92);

    box-shadow:
        0 0 0 4px rgba(255,138,0,.11),
        inset 0 1px 0 rgba(255,255,255,.85);
}

input::placeholder,
textarea::placeholder {
    color: #98a2b3;
}

input[type="checkbox"],
input[type="radio"] {
    accent-color: var(--qa-saffron);
}


/* ============================================================
   TABLES — ENTERPRISE DATA GRID
   ============================================================ */

table {
    width: 100%;
    overflow: hidden;

    border-collapse: separate;
    border-spacing: 0;

    color: var(--qa-text);

    border:
        1px solid var(--qa-line);

    border-radius: 14px;

    background:
        rgba(255,255,255,.58);
}

thead th {
    color: #5d6980;
    background:
        rgba(246,248,252,.76);

    border-bottom:
        1px solid var(--qa-line);

    font-size: 11px;
    font-weight: 850;
    letter-spacing: .02em;
}

tbody td {
    border-bottom:
        1px solid rgba(112,132,161,.11);
}

tbody tr:last-child td {
    border-bottom: 0;
}

tbody tr {
    transition:
        background .15s ease;
}

tbody tr:hover {
    background:
        rgba(255,248,237,.60);
}


/* ============================================================
   STATUS / MESSAGE COLORS
   ============================================================ */

.message.success,
.status-pass,
.status-passed,
.badge-success,
.badge.pass,
.badge.passed {
    color: #087647;
    background: var(--qa-green-soft);
    border-color: rgba(18,169,107,.17);
}

.message.error,
.status-fail,
.status-failed,
.badge-error,
.badge.fail,
.badge.failed {
    color: #c63131;
    background: var(--qa-red-soft);
    border-color: rgba(239,68,68,.16);
}

.message.warning,
.status-warning,
.status-skipped,
.badge-warning,
.badge.skipped {
    color: #a96500;
    background: var(--qa-amber-soft);
    border-color: rgba(233,154,0,.19);
}

.message.info,
.status-info,
.badge-info {
    color: #235fb9;
    background: var(--qa-blue-soft);
    border-color: rgba(52,120,246,.15);
}


/* ============================================================
   API / METHOD BADGES
   ============================================================ */

.method-get,
.http-get {
    color: #2764c7;
    background: #edf4ff;
}

.method-post,
.http-post {
    color: #087647;
    background: #e8faf2;
}

.method-put,
.http-put,
.method-patch,
.http-patch {
    color: #a96500;
    background: #fff5dc;
}

.method-delete,
.http-delete {
    color: #c53232;
    background: #fff0f0;
}


/* ============================================================
   AUTHENTICATION / LOGIN SURFACES
   ============================================================ */

.auth-shell,
.auth-layout {
    position: relative;
}

.auth-card,
.auth-panel {
    border-radius: var(--qa-radius-xl);
}

.auth-art {
    color: var(--qa-navy);
}

.auth-kicker {
    display: inline-flex;
    padding: 7px 11px;
    border-radius: 999px;
}


/* ============================================================
   DASHBOARD / PROJECT HEADERS
   ============================================================ */

.dashboard-header,
.project-header,
.page-header {
    color: var(--qa-navy);
}

.dashboard-header h1,
.project-header h1,
.page-header h1 {
    margin-bottom: 7px;
}


/* ============================================================
   UPLOAD + API SUPPORT PANEL
   ============================================================ */

.api-upload-guidance {
    border-color:
        rgba(255,255,255,.76);

    background:
        linear-gradient(
            145deg,
            rgba(255,255,255,.84),
            rgba(255,255,255,.62)
        );

    box-shadow:
        var(--qa-shadow-lg),
        inset 0 1px 0 rgba(255,255,255,.94);
}

.api-support-frame-wrap {
    border-color:
        rgba(111,132,163,.17);

    background:
        rgba(255,255,255,.54);
}


/* ============================================================
   PUBLIC API SUPPORT SECTION
   ============================================================ */

.public-api-support {
    border-color:
        rgba(255,255,255,.75);

    background:
        linear-gradient(
            145deg,
            rgba(255,255,255,.84),
            rgba(255,255,255,.58)
        );

    box-shadow:
        var(--qa-shadow-lg),
        inset 0 1px 0 rgba(255,255,255,.95);
}

.public-api-support-heading h2 em {
    color: var(--qa-saffron);
}

.public-api-badges span {
    color: #76500d;
    border-color:
        rgba(255,138,0,.14);
    background:
        rgba(255,247,232,.75);
}

.public-api-icon {
    color: #bd5f00;
    background: var(--qa-saffron-soft);
}

.public-api-frame-label {
    color: #c66300;
}

.public-api-callout {
    background:
        linear-gradient(
            120deg,
            rgba(255,244,224,.87),
            rgba(255,255,255,.70)
        );
}


/* ============================================================
   ACTIVE / INTERACTIVE CARDS
   ============================================================ */

.cards article,
.project-card,
.metric-card,
.dashboard-card,
.quick-action,
.action-card {
    transition:
        transform .17s ease,
        border-color .17s ease,
        box-shadow .17s ease;
}

.cards article:hover,
.project-card:hover,
.metric-card:hover,
.dashboard-card:hover,
.quick-action:hover,
.action-card:hover {
    transform: translateY(-2px);

    border-color:
        rgba(255,138,0,.17);

    box-shadow:
        0 18px 42px rgba(35,55,85,.11),
        inset 0 1px 0 rgba(255,255,255,.94);
}

.active-card {
    border-color:
        rgba(255,138,0,.24) !important;

    box-shadow:
        0 15px 38px rgba(255,138,0,.10),
        inset 3px 0 0 var(--qa-saffron),
        inset 0 1px 0 rgba(255,255,255,.95);
}


/* ============================================================
   LINKS
   ============================================================ */

main a:not(.primary-button):not(.outline-button) {
    transition: color .15s ease;
}

main a:not(.primary-button):not(.outline-button):hover {
    color: #d56b00;
}


/* ============================================================
   FOOTER
   ============================================================ */

footer {
    color: #69768c;

    border-top:
        1px solid rgba(111,132,163,.13);

    background:
        rgba(255,255,255,.34);

    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
}


/* ============================================================
   SCROLLBAR
   ============================================================ */

* {
    scrollbar-width: thin;
    scrollbar-color:
        rgba(123,135,157,.42)
        transparent;
}

*::-webkit-scrollbar {
    width: 10px;
    height: 10px;
}

*::-webkit-scrollbar-track {
    background: transparent;
}

*::-webkit-scrollbar-thumb {
    border: 3px solid transparent;
    border-radius: 999px;
    background:
        rgba(113,127,150,.38);
    background-clip: padding-box;
}

*::-webkit-scrollbar-thumb:hover {
    background:
        rgba(90,105,130,.52);
    background-clip: padding-box;
}


/* ============================================================
   ACCESSIBILITY
   ============================================================ */

a:focus-visible,
button:focus-visible,
input:focus-visible,
select:focus-visible,
textarea:focus-visible,
[tabindex]:focus-visible {
    outline:
        3px solid rgba(255,138,0,.28);
    outline-offset: 2px;
}


/* ============================================================
   RESPONSIVE
   ============================================================ */

@media (max-width: 820px) {

    .topbar {
        width: calc(100% - 16px);
        margin-top: 8px;
        border-radius: 16px;
    }

    .hero {
        border-radius: 22px;
        box-shadow:
            0 18px 42px rgba(30,48,76,.10);
    }

    .user-chip {
        padding: 3px;
        border: 0;
        background: transparent;
    }

    .nav-toggle {
        border-color:
            rgba(111,132,163,.21);
        background:
            rgba(255,255,255,.70);

        -webkit-backdrop-filter: blur(12px);
        backdrop-filter: blur(12px);
    }
}

@media (max-width: 540px) {

    :root {
        --qa-radius-lg: 16px;
        --qa-radius-xl: 20px;
    }

    body {
        background:
            radial-gradient(
                circle at 20% 0%,
                rgba(255,174,61,.13),
                transparent 18rem
            ),
            linear-gradient(
                145deg,
                #f5f7fb,
                #edf2f8
            );
    }

    .primary-button,
    .outline-button {
        min-height: 46px;
    }
}


/* ============================================================
   REDUCED MOTION
   ============================================================ */

@media (prefers-reduced-motion: reduce) {

    *,
    *::before,
    *::after {
        scroll-behavior: auto !important;
        transition-duration: .01ms !important;
        animation-duration: .01ms !important;
        animation-iteration-count: 1 !important;
    }
}

/* END PATCH-QAFOX-GLASS-001 */

/* BEGIN PATCH-QAFOX-GLASS-002
   ==========================================================
   AUTHENTICATED ENTERPRISE APPLICATION SHELL
   ========================================================== */

.qa-authenticated {
    --qa-sidebar-width: 248px;
    --qa-shell-gap: 14px;
}


/* ----------------------------------------------------------
   SIDEBAR
   ---------------------------------------------------------- */

.qa-sidebar {
    position: fixed;
    z-index: 55;
    top: 12px;
    bottom: 12px;
    left: 12px;

    width: var(--qa-sidebar-width);

    display: flex;
    flex-direction: column;

    overflow: hidden;

    border:
        1px solid rgba(255,255,255,.82);

    border-radius: 24px;

    background:
        linear-gradient(
            160deg,
            rgba(255,255,255,.88),
            rgba(255,255,255,.62)
        );

    -webkit-backdrop-filter:
        blur(26px)
        saturate(155%);

    backdrop-filter:
        blur(26px)
        saturate(155%);

    box-shadow:
        0 24px 65px rgba(32,49,77,.13),
        inset 0 1px 0 rgba(255,255,255,.97);
}


/* ----------------------------------------------------------
   SIDEBAR BRAND
   ---------------------------------------------------------- */

.qa-sidebar-brand {
    padding: 19px 18px 15px;

    border-bottom:
        1px solid rgba(111,132,163,.12);
}

.qa-sidebar-brand-link {
    display: flex;
    align-items: center;
    gap: 11px;
}

.qa-sidebar-fox {
    display: grid;
    place-items: center;

    width: 42px;
    height: 42px;

    flex: 0 0 auto;

    border-radius: 13px;

    background:
        linear-gradient(
            145deg,
            #fff3dd,
            #ffd394
        );

    font-size: 25px;

    box-shadow:
        inset 0 1px 0 rgba(255,255,255,.95),
        0 7px 16px rgba(255,138,0,.14);
}

.qa-sidebar-brand-link > div {
    display: flex;
    flex-direction: column;
    min-width: 0;
}

.qa-sidebar-brand-link strong {
    font-size: 21px;
    line-height: 1;
    letter-spacing: -.04em;
}

.qa-sidebar-brand-link strong span {
    color: var(--qa-saffron);
}

.qa-sidebar-brand-link small {
    margin-top: 5px;
    color: var(--qa-muted);
    font-size: 10px;
}


/* ----------------------------------------------------------
   SCROLL AREA
   ---------------------------------------------------------- */

.qa-sidebar-scroll {
    flex: 1;

    padding:
        16px 12px 18px;

    overflow-y: auto;
}

.qa-sidebar-label {
    padding: 0 9px 8px;

    color: #8b96a8;

    font-size: 9px;
    font-weight: 900;
    letter-spacing: .12em;
}

.qa-sidebar-section-gap {
    margin-top: 20px;
}


/* ----------------------------------------------------------
   SIDEBAR NAV
   ---------------------------------------------------------- */

.qa-sidebar-nav {
    display: grid;
    gap: 4px;
}

.qa-sidebar-link {
    min-height: 42px;

    padding: 0 10px;

    display: flex;
    align-items: center;
    gap: 10px;

    border-radius: 12px;

    color: #43516a;

    font-size: 12px;
    font-weight: 720;

    transition:
        background .16s ease,
        color .16s ease,
        box-shadow .16s ease,
        transform .16s ease;
}

.qa-sidebar-link:hover {
    color: #c56200;

    background:
        rgba(255,246,231,.78);

    transform:
        translateX(1px);
}

.qa-sidebar-link.is-active {
    color: #c25f00;

    background:
        linear-gradient(
            135deg,
            #fff3df,
            rgba(255,255,255,.83)
        );

    box-shadow:
        inset 0 0 0 1px rgba(255,138,0,.12),
        0 5px 14px rgba(255,138,0,.08);
}

.qa-sidebar-icon {
    display: grid;
    place-items: center;

    width: 24px;
    height: 24px;

    flex: 0 0 auto;

    color: #67758c;

    border-radius: 7px;

    background:
        rgba(241,244,249,.70);

    font-size: 13px;
}

.qa-sidebar-link.is-active
.qa-sidebar-icon {
    color: #bd5c00;
    background: #ffe8c4;
}

.qa-sidebar-link > small {
    margin-left: auto;

    color: #9aa3b2;

    font-size: 9px;
    font-weight: 800;
}

.qa-sidebar-link.is-disabled {
    cursor: default;
    opacity: .68;
}

.qa-sidebar-link.is-disabled:hover {
    color: #43516a;
    background: transparent;
    transform: none;
}


/* ----------------------------------------------------------
   QA MODULE TREE
   ---------------------------------------------------------- */

.qa-module-tree {
    position: relative;

    margin-left: 12px;

    padding-left: 14px;

    border-left:
        1px solid rgba(112,132,161,.18);
}

.qa-module-row {
    position: relative;

    min-height: 37px;

    display: flex;
    align-items: center;
    gap: 8px;

    color: #526078;

    font-size: 11px;
}

.qa-module-row::before {
    content: "";

    position: absolute;

    left: -15px;

    width: 10px;

    border-top:
        1px solid rgba(112,132,161,.18);
}

.qa-module-row.is-active,
.qa-module-row:hover {
    color: #b85a00;
}

.qa-module-row.is-disabled {
    cursor: default;
}

.qa-module-dot {
    width: 6px;
    height: 6px;

    border-radius: 50%;

    background: #c7ced9;
}

.qa-module-dot.active {
    background: var(--qa-green);

    box-shadow:
        0 0 0 4px rgba(18,169,107,.10);
}

.qa-status-chip {
    margin-left: auto;

    padding: 3px 7px;

    border-radius: 999px;

    color: #7458c6;

    background: var(--qa-purple-soft);

    font-size: 8px;
    font-weight: 850;
}

.qa-status-chip.active {
    color: #087647;
    background: var(--qa-green-soft);
}


/* ----------------------------------------------------------
   SIDEBAR ACCOUNT
   ---------------------------------------------------------- */

.qa-sidebar-footer {
    padding: 12px;

    border-top:
        1px solid rgba(111,132,163,.12);

    background:
        rgba(255,255,255,.30);
}

.qa-sidebar-account {
    padding: 10px;

    display: flex;
    align-items: center;
    gap: 9px;

    border:
        1px solid rgba(111,132,163,.13);

    border-radius: 14px;

    background:
        rgba(255,255,255,.55);
}

.qa-sidebar-avatar {
    width: 34px;
    height: 34px;

    display: grid;
    place-items: center;

    flex: 0 0 auto;

    border-radius: 11px;

    color: #9f4f00;

    background:
        linear-gradient(
            145deg,
            #fff0d4,
            #ffc978
        );

    font-size: 12px;
    font-weight: 900;
}

.qa-sidebar-account > div {
    min-width: 0;

    display: flex;
    flex-direction: column;
}

.qa-sidebar-account strong {
    overflow: hidden;

    font-size: 11px;

    text-overflow: ellipsis;
    white-space: nowrap;
}

.qa-sidebar-account small {
    margin-top: 2px;

    overflow: hidden;

    color: var(--qa-muted);

    font-size: 9px;

    text-overflow: ellipsis;
    white-space: nowrap;
}

.qa-sidebar-logout {
    min-height: 34px;

    margin-top: 7px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 10px;

    color: #b33a3a;

    font-size: 10px;
    font-weight: 800;
}

.qa-sidebar-logout:hover {
    background: var(--qa-red-soft);
}


/* ----------------------------------------------------------
   AUTHENTICATED TOP BAR
   ---------------------------------------------------------- */

.qa-authenticated .topbar {
    width:
        calc(
            100%
            - var(--qa-sidebar-width)
            - 40px
        );

    min-height: 62px;

    margin:
        12px
        14px
        0
        calc(
            var(--qa-sidebar-width)
            + 26px
        );

    padding:
        0
        18px;

    border-radius: 18px;
}

.qa-authenticated .topbar > .brand {
    display: none;
}

.qa-authenticated
.topbar
.site-nav {
    display: none;
}

.workspace-context {
    display: flex;
    align-items: center;
    gap: 11px;

    margin-right: auto;
}

.workspace-context > div {
    display: flex;
    flex-direction: column;
}

.workspace-context strong {
    color: var(--qa-navy);

    font-size: 13px;
    line-height: 1.2;
}

.workspace-context small {
    margin-top: 2px;

    color: var(--qa-muted);

    font-size: 9px;
}

.workspace-menu-button {
    width: 34px;
    height: 34px;

    display: grid;
    place-items: center;

    padding: 0;

    border:
        1px solid var(--qa-line) !important;

    border-radius:
        10px !important;

    background:
        rgba(255,255,255,.58) !important;

    box-shadow: none !important;

    color:
        var(--qa-navy) !important;

    font-size: 16px;

    cursor: default;
}


/* ----------------------------------------------------------
   MAIN CONTENT OFFSET
   ---------------------------------------------------------- */

.qa-authenticated .dashboard-main {
    width:
        calc(
            100%
            - var(--qa-sidebar-width)
            - 40px
        );

    min-height:
        calc(100vh - 105px);

    margin-left:
        calc(
            var(--qa-sidebar-width)
            + 26px
        );

    padding-top: 4px;
}

.qa-authenticated
.dashboard-main
> * {
    max-width: 100%;
}


/* Existing pages commonly use their own 90% wrapper.
   Give authenticated views enterprise-console breathing room. */

.qa-authenticated .dashboard-tools,
.qa-authenticated .toolkit {
    width:
        min(
            1280px,
            calc(100% - 28px)
        );

    margin:
        28px auto;
}

.qa-authenticated .dashboard-header,
.qa-authenticated .project-header,
.qa-authenticated .page-header {
    width:
        min(
            1280px,
            calc(100% - 28px)
        );

    margin-left: auto;
    margin-right: auto;
}


/* ----------------------------------------------------------
   AUTHENTICATED FOOTER
   ---------------------------------------------------------- */

.qa-authenticated footer {
    width:
        calc(
            100%
            - var(--qa-sidebar-width)
            - 40px
        );

    margin-left:
        calc(
            var(--qa-sidebar-width)
            + 26px
        );
}


/* ----------------------------------------------------------
   MOBILE / TABLET
   Existing mobile drawer remains source of truth.
   ---------------------------------------------------------- */

@media (max-width: 980px) {

    .qa-sidebar {
        display: none;
    }

    .qa-authenticated {
        --qa-sidebar-width: 0px;
    }

    .qa-authenticated .topbar {
        width:
            calc(100% - 16px);

        margin:
            8px auto 0;

        padding:
            0 12px;
    }

    .qa-authenticated
    .topbar
    .site-nav {
        display: flex;
    }

    .qa-authenticated
    .topbar
    > .brand {
        display: flex;
    }

    .workspace-context {
        display: none;
    }

    .qa-authenticated
    .dashboard-main {
        width: 100%;

        margin-left: 0;
    }

    .qa-authenticated footer {
        width: 100%;

        margin-left: 0;
    }
}


/* ----------------------------------------------------------
   COMPACT MOBILE
   ---------------------------------------------------------- */

@media (max-width: 640px) {

    .qa-authenticated
    .dashboard-main {
        padding-top: 2px;
    }

    .qa-authenticated
    .dashboard-tools,
    .qa-authenticated
    .toolkit {
        width:
            calc(100% - 16px);

        margin:
            18px auto;
    }
}


/* ----------------------------------------------------------
   ACCESSIBILITY
   ---------------------------------------------------------- */

.qa-sidebar-link:focus-visible,
.qa-module-row:focus-visible,
.qa-sidebar-logout:focus-visible {
    outline:
        3px solid rgba(255,138,0,.24);

    outline-offset: 2px;
}

/* END PATCH-QAFOX-GLASS-002 */

/* BEGIN PATCH-QAFOX-GLASS-003
   ==========================================================
   ENTERPRISE DASHBOARD
   ========================================================== */

.qa-enterprise-dashboard {
    width:
        min(
            1400px,
            calc(100% - 28px)
        );

    margin:
        24px auto 38px;
}


/* ----------------------------------------------------------
   HEADING
   ---------------------------------------------------------- */

.qa-dashboard-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;

    margin-bottom: 20px;

    padding:
        0 4px;
}

.qa-dashboard-heading h1 {
    margin:
        6px 0 4px;

    font-size:
        clamp(29px, 3vw, 40px);

    line-height: 1.05;
}

.qa-dashboard-heading p {
    margin: 0;

    font-size: 13px;
}

.qa-eyebrow {
    color: #c36100;

    font-size: 9px;
    font-weight: 900;
    letter-spacing: .13em;
}

.qa-dashboard-heading-actions {
    display: flex;
    gap: 9px;
}


/* ----------------------------------------------------------
   KPI GRID
   ---------------------------------------------------------- */

.qa-kpi-grid {
    display: grid;

    grid-template-columns:
        repeat(6, minmax(0, 1fr));

    gap: 12px;

    margin-bottom: 14px;
}

.qa-kpi-card {
    min-width: 0;
    min-height: 136px;

    padding: 18px 16px;

    display: flex;
    gap: 12px;
    align-items: flex-start;

    border:
        1px solid rgba(255,255,255,.78);

    outline:
        1px solid rgba(111,132,163,.08);

    border-radius: 18px;

    background:
        linear-gradient(
            145deg,
            rgba(255,255,255,.84),
            rgba(255,255,255,.58)
        );

    -webkit-backdrop-filter:
        blur(18px)
        saturate(145%);

    backdrop-filter:
        blur(18px)
        saturate(145%);

    box-shadow:
        0 12px 32px rgba(35,55,85,.075),
        inset 0 1px 0 rgba(255,255,255,.96);

    transition:
        transform .17s ease,
        box-shadow .17s ease;
}

.qa-kpi-card:hover {
    transform:
        translateY(-2px);

    box-shadow:
        0 17px 38px rgba(35,55,85,.105),
        inset 0 1px 0 rgba(255,255,255,.98);
}

.qa-kpi-card > div:last-child {
    min-width: 0;

    display: flex;
    flex-direction: column;
}

.qa-kpi-card span {
    color: #5a6780;

    font-size: 10px;
    font-weight: 760;
}

.qa-kpi-card strong {
    margin:
        7px 0 5px;

    overflow: hidden;

    font-size:
        clamp(21px, 2vw, 29px);

    line-height: 1;

    text-overflow: ellipsis;
}

.qa-kpi-card small {
    color: #7f899a;

    font-size: 9px;
    line-height: 1.4;
}

.qa-kpi-icon {
    width: 38px;
    height: 38px;

    flex: 0 0 auto;

    display: grid;
    place-items: center;

    border-radius: 11px;

    font-size: 17px;
    font-weight: 900;
}

.qa-kpi-icon.purple {
    color: #6550db;
    background: #eeeaff;
}

.qa-kpi-icon.blue {
    color: #2470dd;
    background: #e7f2ff;
}

.qa-kpi-icon.saffron {
    color: #c96600;
    background: #fff0d8;
}

.qa-kpi-icon.green {
    color: #078854;
    background: #e3f8ef;
}

.qa-kpi-icon.red {
    color: #dc3d3d;
    background: #ffeaea;
}


/* ----------------------------------------------------------
   SHARED WIDGET
   ---------------------------------------------------------- */

.qa-glass-widget {
    min-width: 0;

    border:
        1px solid rgba(255,255,255,.79);

    outline:
        1px solid rgba(111,132,163,.08);

    border-radius: 20px;

    background:
        linear-gradient(
            145deg,
            rgba(255,255,255,.84),
            rgba(255,255,255,.57)
        );

    -webkit-backdrop-filter:
        blur(20px)
        saturate(145%);

    backdrop-filter:
        blur(20px)
        saturate(145%);

    box-shadow:
        0 14px 38px rgba(35,55,85,.075),
        inset 0 1px 0 rgba(255,255,255,.97);
}

.qa-widget-heading {
    padding:
        17px 18px 7px;

    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 14px;
}

.qa-widget-heading h2 {
    margin: 0;

    font-size: 14px;
}

.qa-widget-heading p {
    margin: 4px 0 0;

    color: #7a879b;

    font-size: 9px;
}


/* ----------------------------------------------------------
   MIDDLE GRID
   ---------------------------------------------------------- */

.qa-dashboard-middle {
    display: grid;

    grid-template-columns:
        1.5fr .9fr .8fr;

    gap: 14px;

    margin-bottom: 14px;
}


/* ----------------------------------------------------------
   DONUT
   ---------------------------------------------------------- */

.qa-result-overview-body {
    min-height: 245px;

    padding:
        12px 22px 23px;

    display: grid;

    grid-template-columns:
        minmax(190px, .9fr)
        minmax(180px, 1fr);

    align-items: center;
    gap: 24px;
}

.qa-donut-shell {
    display: grid;
    place-items: center;
}

.qa-donut {
    position: relative;

    width: 172px;
    height: 172px;

    display: grid;
    place-items: center;

    border-radius: 50%;

    background:
        conic-gradient(
            var(--qa-green)
                calc(var(--pass) * 1%),
            #edf1f5
                0
        );

    box-shadow:
        0 13px 28px rgba(18,169,107,.14);
}

.qa-donut::after {
    content: "";

    position: absolute;

    width: 116px;
    height: 116px;

    border-radius: 50%;

    background:
        rgba(255,255,255,.92);

    box-shadow:
        inset 0 1px 0 rgba(255,255,255,1);
}

.qa-donut-center {
    position: relative;
    z-index: 2;

    display: flex;
    flex-direction: column;
    align-items: center;
}

.qa-donut-center strong {
    font-size: 24px;
}

.qa-donut-center span {
    margin-top: 3px;

    color: #778397;

    font-size: 9px;
}

.qa-result-legend {
    display: grid;
    gap: 12px;
}

.qa-result-legend > div {
    display: grid;

    grid-template-columns:
        10px 1fr auto;

    align-items: center;
    gap: 8px;
}

.qa-result-legend strong {
    font-size: 10px;
}

.qa-result-legend small {
    color: #768398;

    font-size: 10px;
}

.qa-legend-dot {
    width: 8px;
    height: 8px;

    border-radius: 50%;
}

.qa-legend-dot.passed {
    background: var(--qa-green);
}

.qa-legend-dot.failed {
    background: var(--qa-red);
}

.qa-legend-dot.skipped {
    background: var(--qa-amber);
}

.qa-legend-dot.error {
    background: var(--qa-purple);
}


/* ----------------------------------------------------------
   COVERAGE GAUGE
   ---------------------------------------------------------- */

.qa-coverage-body {
    min-height: 245px;

    padding:
        18px 18px 22px;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

.qa-coverage-gauge {
    width: 190px;
    height: 96px;

    position: relative;

    overflow: hidden;
}

.qa-coverage-gauge::before {
    content: "";

    position: absolute;

    left: 12px;
    right: 12px;
    top: 8px;

    height: 170px;

    border-radius:
        170px 170px 0 0;

    background:
        conic-gradient(
            from 270deg at 50% 100%,
            var(--qa-saffron)
                calc(var(--coverage) * .5%),
            #e9edf2 0 50%,
            transparent 0
        );
}

.qa-coverage-gauge::after {
    content: "";

    position: absolute;

    left: 31px;
    right: 31px;
    top: 27px;

    height: 132px;

    border-radius:
        140px 140px 0 0;

    background:
        rgba(255,255,255,.93);
}

.qa-coverage-gauge > div {
    position: absolute;
    z-index: 3;

    left: 0;
    right: 0;
    bottom: 1px;

    display: flex;
    flex-direction: column;
    align-items: center;
}

.qa-coverage-gauge strong {
    font-size: 31px;
}

.qa-coverage-gauge span {
    color: #66748a;

    font-size: 9px;
    font-weight: 750;
}

.qa-coverage-body p {
    margin:
        13px 0 0;

    text-align: center;

    font-size: 9px;
}


/* ----------------------------------------------------------
   WORKSPACE SUMMARY
   ---------------------------------------------------------- */

.qa-workspace-summary {
    min-height: 245px;

    padding:
        12px 18px 22px;

    display: grid;

    grid-template-columns:
        repeat(2, 1fr);

    gap: 9px;
}

.qa-workspace-summary > div {
    padding: 14px;

    display: flex;
    flex-direction: column;
    justify-content: center;

    border:
        1px solid rgba(111,132,163,.10);

    border-radius: 14px;

    background:
        rgba(255,255,255,.45);
}

.qa-workspace-summary span {
    color: #768398;

    font-size: 9px;
}

.qa-workspace-summary strong {
    margin-top: 5px;

    font-size: 21px;
}


/* ----------------------------------------------------------
   BOTTOM GRID
   ---------------------------------------------------------- */

.qa-dashboard-bottom {
    display: grid;

    grid-template-columns:
        minmax(0, 1fr)
        310px;

    gap: 14px;
}


/* ----------------------------------------------------------
   RECENT TABLE
   ---------------------------------------------------------- */

.qa-table-wrap {
    padding: 8px 14px 16px;

    overflow-x: auto;
}

.qa-dashboard-table {
    margin: 0;

    background:
        rgba(255,255,255,.50);
}

.qa-dashboard-table th,
.qa-dashboard-table td {
    padding:
        11px 12px;

    white-space: nowrap;
}

.qa-dashboard-table th {
    font-size: 9px;
}

.qa-dashboard-table td {
    font-size: 10px;
}

.qa-run-id {
    color: #43516a;

    font-family:
        "SFMono-Regular",
        Consolas,
        monospace;

    font-size: 9px;
    font-weight: 800;
}

.qa-status-badge {
    display: inline-flex;
    align-items: center;

    min-height: 23px;

    padding: 0 8px;

    border-radius: 7px;

    font-size: 8px;
    font-weight: 850;
}

.qa-status-badge.passed {
    color: #087647;
    background: var(--qa-green-soft);
}

.qa-status-badge.failed {
    color: #c43030;
    background: var(--qa-red-soft);
}

.qa-status-badge.skipped {
    color: #a96500;
    background: var(--qa-amber-soft);
}

.qa-status-badge.error {
    color: #6248be;
    background: var(--qa-purple-soft);
}

.qa-status-badge.neutral {
    color: #657187;
    background: #edf0f4;
}

.qa-empty-table {
    min-height: 100px;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    text-align: center;
}

.qa-empty-table strong {
    font-size: 11px;
}

.qa-empty-table span {
    margin-top: 4px;

    color: #8290a4;

    font-size: 9px;
}


/* ----------------------------------------------------------
   QUICK ACTIONS
   ---------------------------------------------------------- */

.qa-actions-widget {
    padding-bottom: 13px;
}

.qa-quick-actions {
    padding: 7px 12px;

    display: grid;
    gap: 8px;
}

.qa-quick-action {
    min-height: 64px;

    padding: 9px 10px;

    display: grid;

    grid-template-columns:
        36px 1fr 14px;

    align-items: center;
    gap: 9px;

    border:
        1px solid rgba(111,132,163,.11);

    border-radius: 13px;

    background:
        rgba(255,255,255,.47);

    transition:
        transform .16s ease,
        background .16s ease,
        border-color .16s ease;
}

.qa-quick-action:hover {
    transform:
        translateX(2px);

    border-color:
        rgba(255,138,0,.18);

    background:
        rgba(255,248,237,.72);
}

.qa-quick-action > span {
    width: 34px;
    height: 34px;

    display: grid;
    place-items: center;

    border-radius: 10px;

    color: #2767d0;
    background: #eaf3ff;

    font-size: 16px;
    font-weight: 800;
}

.qa-quick-action.is-primary {
    border-color:
        rgba(255,138,0,.18);

    background:
        rgba(255,247,232,.64);
}

.qa-quick-action.is-primary > span {
    color: #c76000;
    background: #ffe7bf;
}

.qa-quick-action > div {
    display: flex;
    flex-direction: column;
}

.qa-quick-action strong {
    font-size: 10px;
}

.qa-quick-action small {
    margin-top: 3px;

    color: #7e899b;

    font-size: 8px;
}

.qa-quick-action > b {
    color: #7d899b;

    font-size: 17px;
}


/* ----------------------------------------------------------
   RESPONSIVE
   ---------------------------------------------------------- */

@media (max-width: 1300px) {

    .qa-kpi-grid {
        grid-template-columns:
            repeat(3, minmax(0, 1fr));
    }

    .qa-dashboard-middle {
        grid-template-columns:
            1.2fr 1fr;
    }

    .qa-project-widget {
        grid-column:
            1 / -1;
    }

    .qa-workspace-summary {
        min-height: 0;

        grid-template-columns:
            repeat(4, 1fr);
    }
}

@media (max-width: 900px) {

    .qa-enterprise-dashboard {
        width:
            calc(100% - 16px);

        margin-top: 18px;
    }

    .qa-dashboard-heading {
        align-items: flex-start;
        flex-direction: column;
    }

    .qa-dashboard-heading-actions {
        width: 100%;
    }

    .qa-dashboard-heading-actions a {
        flex: 1;
    }

    .qa-kpi-grid {
        grid-template-columns:
            repeat(2, minmax(0, 1fr));
    }

    .qa-dashboard-middle,
    .qa-dashboard-bottom {
        grid-template-columns: 1fr;
    }

    .qa-result-overview-body {
        grid-template-columns: 1fr;
    }

    .qa-workspace-summary {
        grid-template-columns:
            repeat(2, 1fr);
    }
}

@media (max-width: 520px) {

    .qa-kpi-grid {
        grid-template-columns: 1fr;
    }

    .qa-kpi-card {
        min-height: 105px;
    }

    .qa-dashboard-heading-actions {
        flex-direction: column;
    }

    .qa-workspace-summary {
        grid-template-columns: 1fr 1fr;
    }
}

/* END PATCH-QAFOX-GLASS-003 */

/* BEGIN PATCH-QAFOX-GLASS-003A
   ==========================================================
   VISIBILITY + FONT SIZE CONTROLS
   ========================================================== */

:root {
    --qa-font-scale: 1;
}


/* ----------------------------------------------------------
   GLOBAL READABILITY
   ---------------------------------------------------------- */

.qa-authenticated {
    font-size:
        calc(16px * var(--qa-font-scale));
}

.qa-authenticated p,
.qa-authenticated small,
.qa-authenticated span,
.qa-authenticated label,
.qa-authenticated td,
.qa-authenticated th,
.qa-authenticated a,
.qa-authenticated button,
.qa-authenticated input,
.qa-authenticated select,
.qa-authenticated textarea {
    text-rendering: optimizeLegibility;
}


/* ----------------------------------------------------------
   FONT SCALE MODES
   ---------------------------------------------------------- */

html[data-qa-font-size="compact"] {
    --qa-font-scale: .92;
}

html[data-qa-font-size="normal"] {
    --qa-font-scale: 1;
}

html[data-qa-font-size="large"] {
    --qa-font-scale: 1.14;
}


/* ----------------------------------------------------------
   TOPBAR FONT CONTROLS
   ---------------------------------------------------------- */

.qa-font-controls {
    display: inline-flex;
    align-items: center;

    padding: 3px;

    border:
        1px solid rgba(111,132,163,.17);

    border-radius: 11px;

    background:
        rgba(255,255,255,.58);

    box-shadow:
        inset 0 1px 0 rgba(255,255,255,.9);
}

.qa-font-button {
    min-width: 34px;
    height: 32px;

    padding: 0 7px !important;

    border: 0 !important;
    border-radius: 8px !important;

    color: #4f5d73 !important;

    background:
        transparent !important;

    box-shadow:
        none !important;

    font-size: 12px;
    font-weight: 850;

    cursor: pointer;
}

.qa-font-button:hover {
    color: #bd5d00 !important;

    background:
        rgba(255,243,223,.84) !important;
}

.qa-font-button.is-active {
    color: #fff !important;

    background:
        linear-gradient(
            135deg,
            #ffac24,
            #ff7c00
        ) !important;

    box-shadow:
        0 5px 13px rgba(255,138,0,.22) !important;
}


/* ----------------------------------------------------------
   SIDEBAR READABILITY
   ---------------------------------------------------------- */

.qa-sidebar-label {
    font-size:
        calc(10px * var(--qa-font-scale));

    color: #6c788d;
}

.qa-sidebar-link {
    min-height:
        calc(44px * var(--qa-font-scale));

    font-size:
        calc(13px * var(--qa-font-scale));

    color: #2e3c56;
}

.qa-sidebar-link > small {
    font-size:
        calc(9px * var(--qa-font-scale));
}

.qa-module-row {
    min-height:
        calc(39px * var(--qa-font-scale));

    font-size:
        calc(12px * var(--qa-font-scale));

    color: #415069;
}

.qa-status-chip {
    font-size:
        calc(9px * var(--qa-font-scale));
}

.qa-sidebar-brand-link small {
    font-size:
        calc(11px * var(--qa-font-scale));
}

.qa-sidebar-account strong {
    font-size:
        calc(12px * var(--qa-font-scale));
}

.qa-sidebar-account small {
    font-size:
        calc(10px * var(--qa-font-scale));
}


/* ----------------------------------------------------------
   TOPBAR READABILITY
   ---------------------------------------------------------- */

.workspace-context strong {
    font-size:
        calc(14px * var(--qa-font-scale));
}

.workspace-context small {
    font-size:
        calc(10px * var(--qa-font-scale));

    color: #66758d;
}

.user-chip strong {
    font-size:
        calc(12px * var(--qa-font-scale));
}

.user-chip small {
    font-size:
        calc(10px * var(--qa-font-scale));
}


/* ----------------------------------------------------------
   DASHBOARD READABILITY
   ---------------------------------------------------------- */

.qa-dashboard-heading h1 {
    font-size:
        calc(
            clamp(32px, 3vw, 42px)
            * var(--qa-font-scale)
        );
}

.qa-dashboard-heading p {
    font-size:
        calc(14px * var(--qa-font-scale));

    color: #536078;
}

.qa-eyebrow {
    font-size:
        calc(10px * var(--qa-font-scale));
}

.qa-kpi-card span {
    font-size:
        calc(11px * var(--qa-font-scale));

    color: #46546c;
}

.qa-kpi-card strong {
    font-size:
        calc(
            clamp(24px, 2vw, 31px)
            * var(--qa-font-scale)
        );
}

.qa-kpi-card small {
    font-size:
        calc(10px * var(--qa-font-scale));

    color: #68758a;
}

.qa-widget-heading h2 {
    font-size:
        calc(16px * var(--qa-font-scale));
}

.qa-widget-heading p {
    font-size:
        calc(10px * var(--qa-font-scale));

    color: #66748a;
}

.qa-result-legend strong,
.qa-result-legend small {
    font-size:
        calc(11px * var(--qa-font-scale));
}

.qa-donut-center strong {
    font-size:
        calc(27px * var(--qa-font-scale));
}

.qa-donut-center span {
    font-size:
        calc(10px * var(--qa-font-scale));
}

.qa-coverage-gauge strong {
    font-size:
        calc(34px * var(--qa-font-scale));
}

.qa-coverage-gauge span {
    font-size:
        calc(10px * var(--qa-font-scale));
}

.qa-coverage-body p {
    font-size:
        calc(10px * var(--qa-font-scale));

    color: #5e6c81;
}

.qa-workspace-summary span {
    font-size:
        calc(10px * var(--qa-font-scale));

    color: #5d6b81;
}

.qa-workspace-summary strong {
    font-size:
        calc(24px * var(--qa-font-scale));
}


/* ----------------------------------------------------------
   TABLE READABILITY
   ---------------------------------------------------------- */

.qa-dashboard-table th {
    font-size:
        calc(10px * var(--qa-font-scale));

    color: #4a5870;
}

.qa-dashboard-table td {
    font-size:
        calc(11px * var(--qa-font-scale));
}

.qa-run-id {
    font-size:
        calc(10px * var(--qa-font-scale));
}

.qa-status-badge {
    min-height:
        calc(25px * var(--qa-font-scale));

    font-size:
        calc(9px * var(--qa-font-scale));
}


/* ----------------------------------------------------------
   QUICK ACTIONS
   ---------------------------------------------------------- */

.qa-quick-action {
    min-height:
        calc(68px * var(--qa-font-scale));
}

.qa-quick-action strong {
    font-size:
        calc(11px * var(--qa-font-scale));
}

.qa-quick-action small {
    font-size:
        calc(9px * var(--qa-font-scale));

    color: #69778c;
}


/* ----------------------------------------------------------
   GENERAL BUTTON / FORM READABILITY
   ---------------------------------------------------------- */

.qa-authenticated .primary-button,
.qa-authenticated .outline-button,
.qa-authenticated .secondary-button {
    min-height:
        calc(46px * var(--qa-font-scale));

    font-size:
        calc(13px * var(--qa-font-scale));
}

.qa-authenticated input,
.qa-authenticated select,
.qa-authenticated textarea {
    font-size:
        calc(13px * var(--qa-font-scale));
}


/* ----------------------------------------------------------
   LARGE FONT MODE LAYOUT SAFETY
   ---------------------------------------------------------- */

html[data-qa-font-size="large"]
.qa-kpi-grid {
    grid-template-columns:
        repeat(3, minmax(0, 1fr));
}

html[data-qa-font-size="large"]
.qa-dashboard-middle {
    grid-template-columns:
        1.3fr 1fr;
}

html[data-qa-font-size="large"]
.qa-project-widget {
    grid-column:
        1 / -1;
}

html[data-qa-font-size="large"]
.qa-workspace-summary {
    min-height: auto;

    grid-template-columns:
        repeat(4, 1fr);
}


/* ----------------------------------------------------------
   MOBILE
   ---------------------------------------------------------- */

@media (max-width: 980px) {

    .qa-font-controls {
        margin-left: auto;
    }
}

@media (max-width: 640px) {

    .qa-font-button {
        min-width: 32px;
        height: 32px;
    }

    html[data-qa-font-size="large"]
    .qa-kpi-grid,
    html[data-qa-font-size="large"]
    .qa-dashboard-middle {
        grid-template-columns: 1fr;
    }

    html[data-qa-font-size="large"]
    .qa-workspace-summary {
        grid-template-columns:
            repeat(2, 1fr);
    }
}

