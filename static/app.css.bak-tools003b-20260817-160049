}

.approval-case code {
    margin-top: 4px;
    color: #6341db;
}

.approval-case small {
    margin-top: 5px;
    color: #748097;
}

.destructive-case {
    background: #fff8f1;
    opacity: .78;
}

.approval-safe-badge,
.approval-warning-badge,
.plan-decision {
    padding: 6px 9px;
