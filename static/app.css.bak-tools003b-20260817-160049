/* BEGIN PATCH-QAFOX-GLASS-004
   ==========================================================
   ENTERPRISE API TESTING WORKSPACE
   ========================================================== */

.qa-api-workspace {
    width:
        min(
            1400px,
            calc(100% - 28px)
        );

    margin:
        23px auto 42px;
}


/* ----------------------------------------------------------
   HEADER
   ---------------------------------------------------------- */

.qa-project-workspace-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;

    padding:
        4px 4px 18px;
}

.qa-project-breadcrumb {
    display: inline-flex;

    margin-bottom: 10px;

    color: #647189;

    font-size:
        calc(
            11px
            * var(--qa-font-scale, 1)
        );

    font-weight: 730;
}

.qa-project-breadcrumb:hover {
    color: #c56300;
}

.qa-project-title-row h1 {
    margin:
        5px 0 5px;

    font-size:
        calc(
            clamp(
                30px,
                3vw,
                42px
            )
            * var(--qa-font-scale, 1)
        );

    line-height: 1.04;
}

.qa-project-title-row p {
    max-width: 740px;

    margin: 0;

    color: #56647b;

    font-size:
        calc(
            13px
            * var(--qa-font-scale, 1)
        );
}

.qa-project-header-actions {
    display: flex;
    align-items: center;
    gap: 9px;

    flex-wrap: wrap;
}

.qa-project-header-actions form {
    margin: 0;
}

.qa-project-environment {
    display: inline-flex;
    align-items: center;

    min-height: 34px;

    padding: 0 11px;

    border:
        1px solid rgba(
            52,
            120,
            246,
            .13
        );

    border-radius: 9px;

    color: #2b63ad;

    background:
        var(--qa-blue-soft);

    font-size:
        calc(
            10px
            * var(--qa-font-scale, 1)
        );

    font-weight: 800;
}


/* ----------------------------------------------------------
   PROJECT NAV TABS
   ---------------------------------------------------------- */

.qa-project-tabs {
    position: sticky;

    top: 83px;

    z-index: 30;

    display: flex;
    align-items: center;
    gap: 4px;

    margin-bottom: 14px;

    padding: 6px;

    overflow-x: auto;

    border:
        1px solid rgba(
            255,
            255,
            255,
            .78
        );

    outline:
        1px solid rgba(
            111,
            132,
            163,
            .07
        );

    border-radius: 16px;

    background:
        rgba(
            255,
            255,
            255,
            .72
        );

    -webkit-backdrop-filter:
        blur(22px)
        saturate(150%);

    backdrop-filter:
        blur(22px)
        saturate(150%);

    box-shadow:
        0 10px 26px
        rgba(35,55,85,.07);
}

.qa-project-tab {
    min-height: 39px;

    padding: 0 12px;

    display: inline-flex;
    align-items: center;
    gap: 7px;

    flex: 0 0 auto;

    border-radius: 10px;

    color: #4e5b71;

    font-size:
        calc(
            11px
            * var(--qa-font-scale, 1)
        );

    font-weight: 780;

    transition:
        color .15s ease,
        background .15s ease;
}

.qa-project-tab:hover {
    color: #ba5900;

    background:
        rgba(
            255,
            245,
            226,
            .75
        );
}

.qa-project-tab.is-active {
    color: #bd5c00;

    background:
        linear-gradient(
            135deg,
            #fff0d7,
            #fff9ef
        );

    box-shadow:
        inset 0 0 0 1px
        rgba(255,138,0,.12);
}

.qa-project-tab small {
    min-width: 20px;

    padding: 3px 6px;

    text-align: center;

    border-radius: 999px;

    color: #657187;

    background:
        rgba(
            232,
            237,
            244,
            .8
        );

    font-size: 8px;
}

.qa-project-tab.is-active small {
    color: #ad5500;

    background: #ffe3b8;
}


/* ----------------------------------------------------------
   KPI GRID
   ---------------------------------------------------------- */

.qa-project-kpis {
    display: grid;

    grid-template-columns:
        repeat(
            4,
            minmax(0,1fr)
        );

    gap: 12px;

    margin-bottom: 14px;
}

.qa-project-kpis article {
    min-height: 116px;

    padding: 16px;

    display: flex;
    align-items: flex-start;
    gap: 12px;

    border:
        1px solid
        rgba(255,255,255,.80);

    outline:
        1px solid
        rgba(111,132,163,.07);

    border-radius: 17px;

    background:
        linear-gradient(
            145deg,
            rgba(255,255,255,.84),
            rgba(255,255,255,.58)
        );

    box-shadow:
        0 11px 29px
        rgba(35,55,85,.07),
        inset 0 1px 0
        rgba(255,255,255,.96);
}

.qa-project-kpis article > div {
    min-width: 0;

