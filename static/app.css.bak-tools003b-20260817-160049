        rgba(111,132,163,.10);

    border-radius: 12px;

    background:
        rgba(255,255,255,.46);
}

.qa-security-grid strong,
.qa-security-grid span,
.qa-security-grid small {
    display: block;
}

.qa-security-grid strong {
    font-size:
        calc(
            10px
            * var(--qa-font-scale,1)
        );
}

.qa-security-grid span {
    margin-top: 5px;

    color: #087647;

    font-size:
        calc(
            9px
            * var(--qa-font-scale,1)
        );

    font-weight: 820;
}

.qa-security-grid small {
    margin-top: 5px;

    color: #758297;

    font-size:
        calc(
            8px
            * var(--qa-font-scale,1)
        );

    line-height: 1.4;
}


/* ----------------------------------------------------------
   FILE META
   ---------------------------------------------------------- */

.qa-file-meta-grid {
    padding:
        5px 18px 13px;

    display: grid;

    grid-template-columns:
        repeat(3,1fr);

    gap: 9px;
}

.qa-file-meta-grid > div {
    min-width: 0;

    padding: 12px;

    border:
        1px solid
        rgba(111,132,163,.10);

    border-radius: 11px;

    background:
        rgba(255,255,255,.42);
}

.qa-file-meta-grid small {
    display: block;

    color: #778499;

    font-size:
        calc(
            8px
            * var(--qa-font-scale,1)
        );
}

.qa-file-meta-grid strong {
    display: block;

    margin-top: 5px;

    overflow: hidden;

    font-size:
        calc(
            10px
            * var(--qa-font-scale,1)
        );

    text-overflow: ellipsis;
    white-space: nowrap;
}

.qa-project-hash {
    margin:
        0 18px 18px;

    padding: 12px;

    display: flex;
    align-items: center;
    gap: 12px;

    border:
        1px solid
        rgba(111,132,163,.11);

    border-radius: 11px;

    background:
        rgba(244,247,251,.65);
}

.qa-project-hash > div {
    min-width: 0;
    flex: 1;
}

.qa-project-hash small {
    display: block;

    margin-bottom: 4px;

    color: #748196;

    font-size: 8px;
}

.qa-project-hash code {
    display: block;

    overflow: hidden;

    color: #46546b;

    font-size:
        calc(
            9px
            * var(--qa-font-scale,1)
        );

    text-overflow: ellipsis;
    white-space: nowrap;
}


/* ----------------------------------------------------------
   QUICK ACTIONS
   ---------------------------------------------------------- */

.qa-project-actions-list {
    padding:
        7px 12px 14px;

    display: grid;

    gap: 7px;
}

.qa-project-actions-list form {
    margin: 0;
}

.qa-project-action {
    width: 100%;

    min-height: 61px;

    padding: 9px;

    display: grid;

    grid-template-columns:
        34px 1fr 13px;

    align-items: center;
    gap: 9px;

    border:
        1px solid
        rgba(111,132,163,.11) !important;

    border-radius:
        12px !important;

    color:
        var(--qa-navy) !important;

    background:
        rgba(255,255,255,.46) !important;

    box-shadow:
        none !important;

    text-align: left;

    cursor: pointer;

    transition:
        transform .15s ease,
        border-color .15s ease,
        background .15s ease;
}

.qa-project-action:hover {
    transform:
        translateX(2px);

    border-color:
        rgba(255,138,0,.20) !important;

    background:
        rgba(255,248,236,.68) !important;
}

.qa-project-action.is-primary {
    border-color:
        rgba(255,138,0,.20) !important;

    background:
        rgba(255,244,224,.70) !important;
}

.qa-project-action > span {
    width: 32px;
    height: 32px;

    display: grid;
    place-items: center;

    border-radius: 9px;

    color: #2c6ed3;

    background: #eaf3ff;

    font-size: 14px;
}

.qa-project-action.is-primary
> span {
    color: #bc5a00;
    background: #ffe4b8;
}

.qa-project-action > div {
    min-width: 0;

    display: flex;
    flex-direction: column;
}

.qa-project-action strong {
    font-size:
        calc(
            10px
            * var(--qa-font-scale,1)
        );
}

.qa-project-action small {
    margin-top: 3px;

    color: #758297;

    font-size:
        calc(
            8px
            * var(--qa-font-scale,1)
        );
}

.qa-project-action > b {
    color: #8390a4;
    font-size: 16px;
}


/* ----------------------------------------------------------
   ACTIVITY
   ---------------------------------------------------------- */

.qa-project-activity-list {
    margin: 0;

    padding:
        5px 16px 16px;

    list-style: none;

    display: grid;
    gap: 11px;
}

.qa-project-activity-list li {
    position: relative;

    display: grid;

    grid-template-columns:
        10px 1fr;

    gap: 9px;
}

.qa-activity-dot {
    width: 7px;
    height: 7px;

    margin-top: 5px;

    border-radius: 50%;

    background:
        var(--qa-green);

    box-shadow:
        0 0 0 4px
        rgba(18,169,107,.09);
}

.qa-project-activity-list strong {
    display: block;

    font-size:
        calc(
            9px
            * var(--qa-font-scale,1)
        );

    line-height: 1.45;
}

.qa-project-activity-list small {
    display: block;

    margin-top: 3px;

    color: #8490a3;

    font-size:
        calc(
            8px
            * var(--qa-font-scale,1)
        );
}

.qa-empty-activity {
    color: #7f8b9e;

    font-size: 9px;
}


/* ----------------------------------------------------------
   DANGER
   ---------------------------------------------------------- */

.qa-project-danger-card {
    padding: 15px;

    border-color:
        rgba(239,68,68,.11);

    background:
        rgba(255,248,248,.66);
}

.qa-project-danger-card strong {
    font-size: 10px;
}

.qa-project-danger-card p {
    margin:
        6px 0 10px;

    font-size: 9px;
    line-height: 1.45;
}

.qa-project-danger-card a {
    color: #c43131 !important;

    font-size: 9px;
    font-weight: 850;
}


/* ----------------------------------------------------------
   FONT-SIZE LARGE MODE
   ---------------------------------------------------------- */

html[data-qa-font-size="large"]
.qa-workflow-steps {
    grid-template-columns:
        repeat(3,1fr);
}

html[data-qa-font-size="large"]
.qa-project-content-grid {
    grid-template-columns:
        minmax(0,1fr)
        360px;
}


/* ----------------------------------------------------------
   RESPONSIVE
   ---------------------------------------------------------- */

@media (max-width: 1200px) {

    .qa-project-kpis {
        grid-template-columns:
            repeat(2,1fr);
    }

    .qa-workflow-steps {
        grid-template-columns:
            repeat(3,1fr);
    }

    .qa-security-grid {
        grid-template-columns:
            repeat(2,1fr);
    }
}

@media (max-width: 940px) {

    .qa-project-workspace-header {
        align-items: flex-start;
        flex-direction: column;
    }

    .qa-project-header-actions {
        width: 100%;
    }

    .qa-project-content-grid {
        grid-template-columns: 1fr;
    }

    .qa-project-side-column {
        grid-template-columns:
            repeat(2,1fr);
    }

    .qa-project-action-card {
        grid-row: span 2;
    }
}

@media (max-width: 650px) {

    .qa-api-workspace {
        width:
            calc(100% - 16px);

        margin-top: 16px;
    }

    .qa-project-tabs {
        top: 75px;
    }

    .qa-project-kpis,
    .qa-workflow-steps,
    .qa-security-grid,
    .qa-file-meta-grid,
    .qa-project-side-column {
        grid-template-columns: 1fr;
    }

    .qa-project-header-actions {
        display: grid;
        grid-template-columns: 1fr;
    }

    .qa-project-header-actions
    .primary-button {
        width: 100%;
    }

    .qa-project-hash {
        align-items: stretch;
        flex-direction: column;
    }
}

