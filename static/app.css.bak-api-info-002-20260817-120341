    padding: 16px;
    border: 1px dashed #cbbcff;
    border-radius: 13px;
    background: #fbfaff;
}

.plan-fingerprint span {
    grid-column: 1 / -1;
    color: #748097;
    font-size: 11px;
    font-weight: 900;
}

.plan-fingerprint code {
    overflow-wrap: anywhere;
    color: #35148f;
}

.plan-run-placeholder {
    margin-top: 18px;
    padding: 20px;
    border-radius: 15px;
    background: #f1f3f7;
    text-align: center;
}

.plan-run-placeholder p {
    color: #748097;
    font-size: 12px;
}

.plan-run-placeholder button {
    padding: 12px 17px;
    border: 0;
    border-radius: 10px;
    background: #d4d8e1;
    color: #727b8c;
}

.plan-case-table-wrap {
    overflow-x: auto;
    margin-top: 18px;
    border: 1px solid #e0e5ef;
    border-radius: 16px;
}

.plan-case-table {
    width: 100%;
    min-width: 760px;
    border-collapse: collapse;
    background: #fff;
}

.plan-case-table th,
.plan-case-table td {
    padding: 13px;
    border-top: 1px solid #e8ebf1;
    text-align: left;
    vertical-align: top;
}

.plan-case-table th {
    border-top: 0;
    background: #f7f8fc;
    color: #748097;
    font-size: 10px;
    letter-spacing: .08em;
}

.plan-case-table code {
    display: block;
    margin-top: 4px;
    color: #6341db;
}

@media (max-width: 760px) {
    .execution-approval-shell,
    .execution-plan-detail {
        width: calc(100% - 24px);
        margin-top: 28px;
    }

    .execution-approval-heading {
        align-items: flex-start;
        flex-direction: column;
    }

    .approval-policy-grid,
    .plan-summary-grid {
        grid-template-columns: 1fr 1fr;
    }

    .approval-case {
        grid-template-columns: 22px 55px minmax(0, 1fr);
    }

    .safe-case {
        grid-template-columns: 55px minmax(0, 1fr);
    }

    .approval-case > span {
        grid-column: 2 / -1;
        justify-self: start;
    }

    .plan-information > div {
        grid-template-columns: 1fr;
    }
}

/* PATCH-QAFOX-004C2 — Hardened runner */

.plan-run-confirmation {
    margin-top: 18px;
    padding: 22px;
    border: 1px solid #ffcf9f;
    border-radius: 16px;
    background: #fff8ef;
    text-align: center;
}

.plan-run-confirmation p,
.plan-run-confirmation small {
    color: #7b674e;
}

.plan-run-confirmation code {
    color: #c54820;
    font-weight: 900;
}

.plan-run-confirmation form {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin: 15px 0;
}

.plan-run-confirmation input {
    min-width: 250px;
    padding: 12px 14px;
    border: 1px solid #e4b985;
    border-radius: 10px;
}

.runner-shell {
    width: min(1250px, calc(100% - 48px));
    margin: 48px auto 80px;
}

.runner-heading {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px;
}

.runner-heading a {
    color: #6341db;
    font-size: 13px;
    font-weight: 900;
    text-decoration: none;
}

.runner-heading span {
    display: block;
    margin-top: 12px;
    color: #6d43ff;
    font-size: 10px;
    font-weight: 900;
    letter-spacing: .13em;
}

.runner-heading h1 {
    margin: 7px 0;
    color: #071b43;
    font-size: 42px;
    text-transform: capitalize;
}

.runner-heading p {
    margin: 0;
    color: #748097;
}

.runner-stop-button {
    padding: 11px 14px;
    border: 1px solid #ffb6bd;
    border-radius: 10px;
    background: #fff0f1;
    color: #b42331;
    font-weight: 900;
    cursor: pointer;
}

.runner-progress {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr);
    align-items: center;
    gap: 18px;
    margin-top: 24px;
    padding: 18px;
    border: 1px solid #e0e5ef;
    border-radius: 15px;
    background: #fff;
}

.runner-progress strong,
.runner-progress span {
    display: block;
}

.runner-progress strong {
    color: #071b43;
    font-size: 25px;
}

.runner-progress span {
    color: #748097;
    font-size: 11px;
}

.runner-progress progress {
    width: 100%;
    height: 14px;
    accent-color: #6d43ff;
}

.runner-stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
    margin: 16px 0;
}

.runner-stats article {
    padding: 18px;
    border-radius: 14px;
}

.runner-stats strong,
.runner-stats span {
    display: block;
}

.runner-stats strong {
    font-size: 26px;
}

.runner-stats span {
    font-size: 11px;
}

.runner-stats .passed {
    background: #eafff5;
    color: #087a50;
}

.runner-stats .failed {
    background: #fff6df;
    color: #946000;
}

.runner-stats .error {
    background: #fff0f1;
    color: #b42331;
}

.runner-stats .skipped {
    background: #f0f2f6;
    color: #69758a;
}

.runner-table-wrap {
    overflow-x: auto;
    border: 1px solid #e0e5ef;
    border-radius: 16px;
    background: #fff;
}

.runner-table {
    width: 100%;
    min-width: 950px;
    border-collapse: collapse;
}

.runner-table th,
.runner-table td {
    padding: 13px;
    border-top: 1px solid #e8ebf1;
    text-align: left;
    vertical-align: top;
}

.runner-table th {
    border-top: 0;
    background: #f7f8fc;
    color: #748097;
    font-size: 10px;
    letter-spacing: .08em;
}

.runner-table code {
    display: block;
    margin-top: 4px;
    color: #6341db;
}

.runner-table pre {
    max-width: 540px;
    max-height: 220px;
    overflow: auto;
    padding: 10px;
    border-radius: 8px;
    background: #111827;
    color: #e5e7eb;
    white-space: pre-wrap;
}

.run-result-status {
    display: inline-block;
    padding: 6px 9px;
    border-radius: 999px;
    font-size: 10px;
    font-weight: 900;
}

.run-result-status.passed {
    background: #dcfaeb;
    color: #087a50;
}

.run-result-status.failed {
    background: #fff0d5;
    color: #945600;
}

.run-result-status.error {
    background: #ffe2e5;
    color: #b42331;
}

.run-result-status.skipped {
    background: #edf0f5;
    color: #69758a;
}

@media (max-width: 760px) {
    .runner-shell {
        width: calc(100% - 24px);
        margin-top: 28px;
    }

    .runner-heading {
        align-items: stretch;
        flex-direction: column;
    }

    .runner-stats {
        grid-template-columns: 1fr 1fr;
    }

    .runner-progress {
        grid-template-columns: 1fr;
    }

    .plan-run-confirmation form {
        align-items: stretch;
        flex-direction: column;
    }

    .plan-run-confirmation input {
        min-width: 0;
    }
}

