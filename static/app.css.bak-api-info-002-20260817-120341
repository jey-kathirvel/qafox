}

.approval-safe-badge,
.plan-decision.included {
    background: #dcfaeb;
    color: #087a50;
}

.approval-warning-badge {
    background: #fff0d5;
    color: #945600;
}

.plan-decision.excluded {
    background: #edf0f5;
    color: #69758a;
}

.approval-confirmation {
    display: grid;
    gap: 16px;
    border-color: #cfc2ff;
    background: #faf8ff;
}

.approval-confirm-check {
    grid-template-columns: 20px minmax(0, 1fr) !important;
    align-items: start;
}

.approval-confirm-check input {
    width: 18px;
    height: 18px;
    margin: 1px 0 0;
}

.approval-confirm-check small {
    display: block;
    margin-top: 4px;
    color: #748097;
    font-weight: 500;
}

.destructive-notice {
    padding: 12px;
    border-radius: 10px;
    background: #fff0d5;
    color: #945600;
    font-size: 12px;
    font-weight: 900;
}

.approval-confirmation > p {
    margin: 0;
    color: #748097;
    font-size: 11px;
    text-align: center;
}

.approval-empty,
.approval-empty-state {
    padding: 45px;
    border: 1px dashed #d5caff;
    border-radius: 18px;
    color: #748097;
    text-align: center;
}

.approval-empty-state > div {
    font-size: 55px;
}

.plan-success-card {
    margin-top: 22px;
    padding: 28px;
    border: 1px solid #bcebd5;
    border-radius: 22px;
    background: linear-gradient(135deg, #effff7, #fff);
}

.plan-information {
