/* PATCH-QAFOX-004A1 — Smart configuration */

.smart-config-panel {
    margin: 0 0 24px;
    padding: 20px;
    border: 1px solid #d9ccff;
    border-radius: 18px;
    background:
        linear-gradient(
            135deg,
            #f8f5ff 0%,
            #ffffff 65%
        );
    box-shadow: 0 14px 36px rgba(62, 34, 130, 0.08);
}

.smart-config-heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 18px;
    margin-bottom: 16px;
}

.smart-config-heading > div {
    min-width: 0;
}

.smart-config-kicker {
    display: block;
    margin-bottom: 5px;
    color: #6d43ff;
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
}

.smart-config-heading h3 {
    margin: 0;
    color: #071b43;
    font-size: 20px;
}

.smart-config-heading p {
    margin: 6px 0 0;
    color: #66738c;
    font-size: 13px;
    line-height: 1.55;
}

.smart-config-confidence {
    flex: 0 0 auto;
    padding: 7px 11px;
    border-radius: 999px;
    background: #e5fff3;
    color: #087a50;
    font-size: 11px;
    font-weight: 900;
}

.smart-config-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
}

.smart-suggestion-card {
    min-width: 0;
    padding: 14px;
    border: 1px solid #e4e8f1;
    border-radius: 14px;
    background: #ffffff;
}

.smart-suggestion-card strong {
    display: block;
    margin-bottom: 5px;
    color: #071b43;
    font-size: 13px;
}

.smart-suggestion-value {
    display: block;
    overflow-wrap: anywhere;
    color: #5e35dc;
    font-size: 13px;
    font-weight: 800;
}

.smart-suggestion-source {
    display: block;
    margin-top: 5px;
    color: #768198;
    font-size: 11px;
    line-height: 1.45;
}

.smart-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    margin-top: 15px;
}

.smart-action-button {
    min-height: 38px;
    padding: 0 14px;
    border: 1px solid #d7ccff;
    border-radius: 10px;
    background: #ffffff;
    color: #5e35dc;
    font: inherit;
    font-size: 12px;
    font-weight: 900;
    cursor: pointer;
}

.smart-action-button.primary {
    border-color: transparent;
    background: #6d43ff;
    color: #ffffff;
}

.smart-action-button:disabled {
    cursor: wait;
    opacity: 0.65;
}

.smart-url-preview {
    margin-top: 14px;
    padding: 12px 14px;
    border: 1px dashed #cbbcff;
    border-radius: 12px;
    background: #fbfaff;
}

.smart-url-preview span {
    display: block;
    margin-bottom: 4px;
    color: #768198;
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
}

.smart-url-preview code {
    color: #35148f;
    font-size: 12px;
    font-weight: 800;
    overflow-wrap: anywhere;
}

.smart-connection-result {
    display: none;
    margin-top: 12px;
    padding: 11px 13px;
    border-radius: 11px;
    font-size: 12px;
    font-weight: 800;
}

.smart-connection-result.visible {
    display: block;
}

.smart-connection-result.success {
    border: 1px solid #bcebd5;
    background: #edfff6;
    color: #087a50;
}

.smart-connection-result.error {
    border: 1px solid #ffc9ce;
    background: #fff0f1;
    color: #b42331;
}

/* Correct checkbox and explanatory-text overlap. */
.config-form .config-checkbox {
    position: relative;
    display: grid;
    grid-template-columns: 20px minmax(0, 1fr);
    align-items: start;
    gap: 10px;
    width: 100%;
    min-height: auto;
    margin: 14px 0;
    padding: 13px 14px;
