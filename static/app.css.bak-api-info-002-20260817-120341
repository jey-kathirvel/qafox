}

.approval-policy-grid article,
.plan-summary-grid article {
    padding: 15px;
    border-radius: 13px;
    background: #f7f8fc;
}

.approval-policy-grid strong,
.approval-policy-grid span,
.plan-summary-grid strong,
.plan-summary-grid span {
    display: block;
}

.approval-policy-grid span,
.plan-summary-grid span {
    margin-top: 4px;
    color: #748097;
    font-size: 11px;
}

.plan-summary-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
