}

.api-support-frame-wrap[hidden] {
    display: none;
}

.api-support-frame {
    display: block;
    width: 100%;
    height: 680px;
    border: 0;
    background: #ffffff;
}

.api-guidance-action {
    display: flex;
    justify-content: flex-end;
    margin-top: 16px;
}

.api-guidance-action .primary-button {
    width: auto;
}

.api-guidance-toggle {
    flex: 0 0 auto;
}

@media (max-width: 760px) {

    .api-upload-guidance {
        margin-bottom: 18px;
        padding: 15px;
        border-radius: 18px;
    }

    .api-upload-guidance-head {
        display: grid;
        grid-template-columns: 1fr;
        gap: 12px;
    }

    .api-guidance-toggle {
        width: 100%;
    }

    .api-support-frame {
        height: 620px;
    }

    .api-guidance-action {
        display: block;
    }

    .api-guidance-action .primary-button {
        width: 100%;
    }
}

