                text.includes(field)
        );
    }


    function extractSchemaFields() {

        const raw =
            byId("qa-testdata-schema")
                ?.value
                ?.trim()
            || "";

        if (!raw) {
            return [];
        }

        try {

            const parsed =
                JSON.parse(raw);

            if (
                parsed
                && typeof parsed === "object"
                && !Array.isArray(parsed)
            ) {

                if (
                    parsed.properties
                    && typeof parsed.properties
                        === "object"
                ) {
                    return Object.keys(
                        parsed.properties
                    );
                }

                return Object.keys(parsed);
            }

        } catch (_) {
            // Continue with text field parsing.
        }

        return raw
            .split(/[,\n]/)
            .map(
                (field) =>
                    field
                        .replace(
                            /["'{}\[\]:]/g,
                            ""
                        )
                        .trim()
            )
            .filter(Boolean)
            .slice(0, 30);
    }


    function inferFields(prompt, domainKey) {

        const schemaFields =
            extractSchemaFields();

        if (schemaFields.length) {
            return schemaFields;
        }

        const promptFields =
            extractPromptFields(prompt);

        if (promptFields.length) {
            return promptFields;
        }

        return [
            ...domainKnowledge[
                domainKey
            ].fields
        ];
