        const scenarios = [];

        fields.forEach((field) => {

            const type =
                detectFieldType(field);

            scenarios.push({
                field,
                type,
                scenario: "Valid",
                expected: "Accept",
                reason:
                    `Confirm ${field} accepts a normal valid ${type} value.`,
            });

            scenarios.push({
                field,
                type,
                scenario: "Invalid",
                expected: "Reject",
                reason:
                    `Confirm malformed ${field} input is rejected with clear validation.`,
            });

            scenarios.push({
                field,
                type,
                scenario: "Boundary",
                expected:
                    "Validate boundary",
                reason:
                    `Exercise minimum, maximum and near-limit behavior for ${field}.`,
            });

            if (
                objective === "security"
                || type === "text"
                || type === "name"
                || type === "id"
            ) {
                scenarios.push({
                    field,
                    type,
                    scenario: "Security",
                    expected:
                        "Reject / safely handle",
                    reason:
                        `Verify ${field} treats hostile-looking strings strictly as data.`,
                });
            }

            if (
                objective === "localization"
                || type === "name"
                || type === "address"
                || type === "text"
            ) {
                scenarios.push({
