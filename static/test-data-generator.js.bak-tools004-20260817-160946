        loc
    ) {
        if (mode === "invalid") {
            return pick(
                [
                    "",
                    "???",
                    "No Postal Code",
                    "123",
                ],
                rng
            );
        }

        if (mode === "boundary") {
            return index % 2
                ? "1 A"
                : (
                    "QA Test Address "
                    + "X".repeat(220)
                );
        }

        if (mode === "security") {
            return "../../etc/passwd";
