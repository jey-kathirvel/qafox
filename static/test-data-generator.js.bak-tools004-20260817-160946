    function normalize(text) {
        return String(text || "")
            .toLowerCase()
            .replace(/[^a-z0-9_ -]/g, " ")
            .replace(/\s+/g, " ")
            .trim();
    }


    function detectDomain(prompt) {

        const selected =
            byId("qa-testdata-domain")?.value
            || "auto";

        if (
            selected !== "auto"
            && domainKnowledge[selected]
        ) {
            return {
                key: selected,
                score: 100,
                source: "preset",
            };
        }

        const text = normalize(prompt);

        let best = {
            key: "general",
            score: 0,
            source: "inferred",
        };

        Object.entries(domainKnowledge)
            .forEach(([key, domain]) => {

                if (key === "general") {
                    return;
                }

                let score = 0;

                domain.keywords.forEach(
                    (keyword) => {

                        if (
                            text.includes(
                                normalize(keyword)
                            )
                        ) {
                            score += 1;
                        }
                    }
                );

                if (score > best.score) {
                    best = {
                        key,
                        score,
                        source: "inferred",
                    };
                }
            });

        return best;
    }


    function detectObjective(prompt) {

        const selected =
            byId("qa-testdata-objective")
                ?.value
            || "auto";

        if (selected !== "auto") {
            return selected;
        }

        const text = normalize(prompt);

        if (
            /security|injection|xss|malicious|attack/.test(
                text
            )
        ) {
            return "security";
        }

        if (
            /boundary|min|max|limit|length/.test(
                text
            )
        ) {
            return "boundary";
        }

        if (
            /invalid|negative|reject|error/.test(
                text
            )
        ) {
            return "negative";
        }

        if (
            /unicode|localization|localisation|tamil|language/.test(
                text
            )
        ) {
            return "localization";
        }

        if (
            /api|json|endpoint|payload|integration/.test(
                text
            )
        ) {
            return "integration";
        }

        return "functional";
    }


