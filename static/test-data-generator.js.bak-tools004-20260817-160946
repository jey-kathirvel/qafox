        if (modes.includes("boundary")) {
            insights.push(
                "boundary handling"
            );
        }

        if (modes.includes("security")) {
            insights.push(
                "safe handling of hostile-looking input"
            );
        }

        if (modes.includes("unicode")) {
            insights.push(
                "international character support"
            );
        }

        if (!insights.length) {
            insights.push(
                "happy-path validation"
