    function hashSeed(value) {
        let hash = 2166136261;

        for (const char of String(value || "qafox")) {
            hash ^= char.charCodeAt(0);
            hash = Math.imul(hash, 16777619);
        }

        return hash >>> 0;
    }


    function makeRng(seedText) {
        let seed = hashSeed(seedText);

        return () => {
            seed += 0x6D2B79F5;

            let t = seed;

            t = Math.imul(
                t ^ (t >>> 15),
                t | 1
            );

            t ^= t + Math.imul(
                t ^ (t >>> 7),
                t | 61
            );

            return (
                (
                    t ^ (t >>> 14)
                ) >>> 0
            ) / 4294967296;
        };
    }


    function pick(items, rng) {
        return items[
            Math.floor(rng() * items.length)
        ];
    }


    function integer(min, max, rng) {
        return Math.floor(
            rng() * (max - min + 1)
        ) + min;
    }


    function uuid(rng) {
        const hex = "0123456789abcdef";

        const part = (length) => {
            let out = "";

            for (let i = 0; i < length; i += 1) {
                out += hex[
                    Math.floor(rng() * 16)
                ];
            }

            return out;
        };

        return [
            part(8),
            part(4),
            "4" + part(3),
            pick(
                ["8", "9", "a", "b"],
                rng
            ) + part(3),
            part(12),
        ].join("-");
    }


    function scenarioModes() {
        const modes = $$(
            "[data-testdata-mode]:checked"
        ).map(
            (item) => item.value
        );

        return modes.length
            ? modes
            : ["valid"];
    }


    function locale() {
        return (
            $("#qa-testdata-locale")?.value
            || "india"
        );
    }


    function personName(rng, loc) {
        const first = pick(
            firstNames[loc]
                || firstNames.global,
            rng
        );

        const last = pick(
            lastNames[loc]
                || lastNames.global,
            rng
        );

        return `${first} ${last}`;
    }


    function emailFor(name, index) {
        const clean = name
            .toLowerCase()
            .normalize("NFKD")
            .replace(
                /[^a-z0-9 ]/g,
                ""
            )
            .trim()
            .replace(/\s+/g, ".");

        return (
            `${clean || "tester"}`
            + `.${index}@example.test`
        );
    }


    function mobileFor(loc, index, rng) {
        const suffix = String(
            integer(
                10000000,
                99999999,
                rng
            )
        );

        if (loc === "india") {
            return (
                "+91 9"
                + String(
                    index % 10
                )
                + suffix
            ).slice(0, 14);
        }

        if (loc === "uk") {
            return (
                "+44 7700 "
                + String(
                    900000 + (index % 99999)
                )
            );
        }

        if (loc === "usa") {
            return (
                "+1 202-555-"
                + String(
                    1000 + (index % 8999)
                )
            );
        }

        return (
            "+99 555 "
            + String(
                100000 + (index % 899999)
            )
        );
    }


    function addressFor(loc, index, rng) {
        const pool = (
            cities[loc]
            || cities.global
        );

        const [city, region, postal] =
            pick(pool, rng);

        return (
            `${integer(1, 499, rng)} `
            + `QA Test Street, ${city}, `
            + `${region} ${postal}`
        );
    }


    function isoDate(
        year,
        month,
        day
    ) {
        return (
            String(year).padStart(4, "0")
            + "-"
            + String(month).padStart(2, "0")
            + "-"
            + String(day).padStart(2, "0")
        );
    }


    function validDate(rng) {
        return isoDate(
            integer(1980, 2004, rng),
            integer(1, 12, rng),
            integer(1, 28, rng)
        );
    }


    function scenarioForIndex(
        index,
        modes
    ) {
        return modes[
            index % modes.length
        ];
    }


    function expectedFor(mode) {
        if (mode === "valid") {
            return "Accept";
        }

        if (mode === "boundary") {
            return "Validate boundary";
        }

        if (mode === "unicode") {
            return "Accept if supported";
        }

        if (mode === "security") {
            return "Reject / safely handle";
        }

        return "Reject";
    }


    const modeReasons = {
        valid:
            "Happy-path data should be accepted by normal validation.",

        invalid:
            "Confirms invalid or malformed input is rejected correctly.",

        boundary:
            "Tests minimum, maximum or near-limit behavior.",

        security:
            "Checks that hostile-looking text is treated only as input data.",

        unicode:
            "Checks international and multi-byte character handling.",
    };


    function personValue(
        mode,
        index,
        rng,
        loc
    ) {
        if (mode === "invalid") {
            return "";
        }

        if (mode === "boundary") {
            return index % 2
                ? "A"
                : "A".repeat(120);
        }

        if (mode === "security") {
            return "' OR '1'='1 --";
        }

        if (mode === "unicode") {
            return pick(
                [
                    "ஜெய் கதிர்வேல்",
                    "மீனா ராஜ்",
                    "Zoë García",
                    "山田 太郎",
                    "محمد علي",
                    "QA Tester 🦊",
                ],
                rng
            );
        }

        return personName(
            rng,
            loc
        );
    }


    function contactValue(
        mode,
        index,
        rng,
        loc
    ) {
        const name = personName(
            rng,
            loc
        );

        if (mode === "invalid") {
            return pick(
                [
                    "tester@",
                    "@example.test",
                    "not-an-email",
                    "98765ABC",
                    "",
                ],
                rng
            );
        }

        if (mode === "boundary") {
            return index % 2
                ? "a@b.co"
                : (
                    "a".repeat(60)
                    + "@example.test"
                );
        }

        if (mode === "security") {
            return (
                "<script>"
                + "alert(1)"
                + "</script>@example.test"
            );
        }

        if (mode === "unicode") {
            return "தமிழ்.tester@example.test";
        }

        return (
            emailFor(name, index + 1)
            + " | "
            + mobileFor(
                loc,
                index + 1,
                rng
            )
        );
    }


    function addressValue(
        mode,
        index,
