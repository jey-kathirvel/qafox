            + " | Aadhaar-like: "
            + "9999 0000 "
            + String(
                1000 + (index % 8999)
            )
            + " (synthetic)"
        );
    }


    function internetValue(
        mode,
        index,
        rng
    ) {
        if (mode === "invalid") {
            return pick(
                [
                    "http://",
                    "999.999.999.999",
                    "not a url",
                    "user@@example.test",
                ],
                rng
            );
        }

        if (mode === "boundary") {
            return (
                "https://"
                + "a".repeat(60)
                + ".example.test"
            );
        }

        if (mode === "security") {
            return (
                "https://example.invalid/"
                + "?q=<script>alert(1)</script>"
            );
        }

        if (mode === "unicode") {
            return "https://例え.example/";
        }

        return (
            `https://api${index + 1}.example.test/`
            + `v1/resource/${integer(1, 999, rng)}`
        );
    }


    function datetimeValue(
        mode,
        index,
        rng
    ) {
        if (mode === "invalid") {
            return pick(
                [
                    "2026-13-40",
                    "not-a-date",
                    "00/00/0000",
                    "",
                ],
                rng
            );
        }

        if (mode === "boundary") {
            return index % 2
                ? "1970-01-01T00:00:00Z"
                : "9999-12-31T23:59:59Z";
        }

        if (mode === "security") {
            return "2026-01-01' OR '1'='1";
        }

        if (mode === "unicode") {
            return "17 ஆகஸ்ட் 2026";
        }

        return (
            validDate(rng)
            + "T"
            + String(
                integer(0, 23, rng)
            ).padStart(2, "0")
            + ":"
            + String(
                integer(0, 59, rng)
            ).padStart(2, "0")
            + ":00Z"
        );
    }


    function numberValue(
        mode,
        index,
        rng
    ) {
        if (mode === "invalid") {
            return pick(
                [
                    "NaN",
                    "Infinity",
                    "12ABC",
                    "",
                    "null",
                ],
                rng
            );
        }

        if (mode === "boundary") {
            return pick(
                [
                    "0",
                    "-1",
                    "1",
                    "2147483647",
                    "2147483648",
                    "-2147483648",
                ],
                rng
            );
        }

        if (mode === "security") {
            return "1 OR 1=1";
        }

        if (mode === "unicode") {
            return "₹ १२३४.५६";
        }

        return String(
            (
                integer(
                    100,
                    999999,
                    rng
                ) / 100
            ).toFixed(2)
        );
    }


    function textValue(
        mode,
        index,
        rng
    ) {
        if (mode === "invalid") {
            return pick(
                [
                    "",
                    "   ",
                    "\\u0000",
                    "null",
                ],
                rng
            );
        }

        if (mode === "boundary") {
            return index % 2
                ? "A"
                : "X".repeat(255);
        }

        if (mode === "security") {
            return pick(
                [
                    "' OR '1'='1 --",
                    "<script>alert(1)</script>",
                    "../../etc/passwd",
                    "${jndi:ldap://example.invalid/a}",
                ],
                rng
            );
        }

        if (mode === "unicode") {
            return pick(
                [
                    "தமிழ் சோதனை தரவு",
                    "Español ñ á é í ó ú",
                    "日本語テスト",
                    "Emoji QA 🦊 ✅ 🚀",
                    "العربية اختبار",
                ],
                rng
            );
        }

        return (
            "QAFox synthetic test text "
            + String(index + 1)
        );
    }


    function apiValue(
        mode,
        index,
        rng,
        loc
    ) {
        const name = personName(
            rng,
            loc
        );

        let value = {
            customerId: uuid(rng),
            name,
            email: emailFor(
                name,
                index + 1
            ),
            active: true,
            amount: Number(
                (
                    integer(
                        100,
                        500000,
                        rng
                    ) / 100
                ).toFixed(2)
            ),
        };

        if (mode === "invalid") {
            value = {
                customerId: 123,
                name: null,
                email: "invalid@",
                active: "yes",
                amount: "not-a-number",
            };
        }

        if (mode === "boundary") {
            value = {
                customerId: uuid(rng),
                name: "X".repeat(255),
                email: "a@b.co",
                active: false,
                amount: 0,
            };
        }

        if (mode === "security") {
            value = {
                customerId:
                    "' OR '1'='1 --",
                name:
                    "<script>alert(1)</script>",
                email:
                    "tester@example.test",
                active: true,
                amount: 1,
            };
        }

        if (mode === "unicode") {
            value = {
                customerId: uuid(rng),
                name: "தமிழ் பயனர் 🦊",
                email:
                    "unicode@example.test",
                active: true,
                amount: 1234.56,
            };
        }

        return JSON.stringify(
            value,
            null,
            2
        );
    }


    function edgeValue(
        mode,
        index,
        rng
    ) {
        const values = {
            valid: [
                "normal-value",
                "123",
                "true",
            ],

            invalid: [
                "",
                "   ",
                "null",
                "undefined",
                "NaN",
            ],

            boundary: [
                "A",
                "X".repeat(255),
                "0",
                "-1",
                "2147483648",
            ],

            security: [
                "' OR '1'='1 --",
                "<script>alert(1)</script>",
                "../../etc/passwd",
                "${jndi:ldap://example.invalid/a}",
            ],

            unicode: [
                "தமிழ்",
                "🦊🚀✅",
                "日本語",
                "Español ñ",
            ],
        };

        return pick(
            values[mode]
                || values.valid,
            rng
        );
    }


    function uuidValue(
        mode,
        index,
        rng
    ) {
        if (mode === "invalid") {
            return pick(
                [
                    "123",
                    "not-a-uuid",
                    "0000",
                    "",
                ],
                rng
            );
        }

        if (mode === "boundary") {
            return index % 2
                ? "0"
                : "9".repeat(64);
        }

        if (mode === "security") {
            return "../" + uuid(rng);
        }

        if (mode === "unicode") {
            return "QA-அடையாளம்-" + (index + 1);
        }

        return uuid(rng);
    }


    function generateValue(
        generator,
        mode,
        index,
        rng,
        loc
    ) {
        switch (generator) {
            case "person":
                return personValue(
                    mode,
                    index,
                    rng,
                    loc
                );

            case "contact":
                return contactValue(
                    mode,
                    index,
                    rng,
                    loc
                );

            case "address":
                return addressValue(
                    mode,
                    index,
                    rng,
                    loc
                );

            case "payment":
                return paymentValue(
                    mode,
                    index,
                    rng
                );

            case "identity":
                return identityValue(
                    mode,
                    index,
                    rng
                );

            case "internet":
                return internetValue(
                    mode,
                    index,
                    rng
                );

            case "datetime":
                return datetimeValue(
                    mode,
                    index,
                    rng
                );

            case "number":
                return numberValue(
                    mode,
                    index,
                    rng
                );

            case "text":
                return textValue(
                    mode,
                    index,
                    rng
                );

            case "api":
                return apiValue(
                    mode,
                    index,
                    rng,
                    loc
                );

            case "edge":
                return edgeValue(
                    mode,
                    index,
                    rng
                );

            case "uuid":
                return uuidValue(
                    mode,
                    index,
                    rng
                );

            default:
                return textValue(
                    mode,
                    index,
                    rng
                );
        }
    }


    function scenarioLabel(mode) {
        return {
            valid: "Valid",
            invalid: "Invalid",
            boundary: "Boundary",
            security: "Security",
            unicode: "Unicode",
        }[mode] || "Valid";
    }


    function buildRows() {
        const countInput =
            $("#qa-testdata-count");

        const count = Math.max(
            1,
            Math.min(
                50,
                Number(
                    countInput?.value || 10
                )
            )
        );

        if (countInput) {
            countInput.value = String(count);
        }

        const modes = scenarioModes();
        const loc = locale();

        const seed = (
            $("#qa-testdata-seed")?.value
            || "qafox"
        );

        const rng = makeRng(
            `${seed}|${activeGenerator}|${loc}`
        );

        currentRows = [];

        for (
            let index = 0;
            index < count;
            index += 1
        ) {
            const mode = scenarioForIndex(
                index,
                modes
            );

            currentRows.push({
                id: index + 1,
                scenario:
                    scenarioLabel(mode),
                scenarioKey: mode,
                type:
                    generatorNames[
                        activeGenerator
                    ],
                value:
                    generateValue(
                        activeGenerator,
                        mode,
                        index,
                        rng,
                        loc
                    ),
                expected:
                    expectedFor(mode),
                reason:
                    modeReasons[mode],
            });
        }

        renderRows();
    }


    function escapeHtml(value) {
        const element =
            document.createElement("div");

        element.textContent =
            String(value ?? "");

        return element.innerHTML;
    }


    function renderRows() {
        tableBody.innerHTML =
            currentRows.map(
                (row) => `
                <tr>
                    <td>
                        ${row.id}
                    </td>

                    <td>
                        <span class="qa-data-scenario ${row.scenarioKey}">
                            ${escapeHtml(row.scenario)}
                        </span>
                    </td>

                    <td>
                        <span class="qa-data-type">
                            ${escapeHtml(row.type)}
                        </span>
                    </td>

                    <td class="qa-data-value-cell">
                        <code>${escapeHtml(row.value)}</code>
                    </td>

                    <td>
                        <span class="qa-data-expected">
                            ${escapeHtml(row.expected)}
                        </span>
                    </td>

                    <td class="qa-data-reason">
                        ${escapeHtml(row.reason)}
                    </td>

                    <td>
                        <button
                            type="button"
                            class="qa-data-copy"
                            data-copy-row="${row.id - 1}"
                            title="Copy generated value">
                            ⧉
                        </button>
                    </td>
                </tr>
                `
            ).join("");

        const title =
            $("#qa-testdata-result-title");

        if (title) {
            title.textContent =
                `${
                    generatorNames[
                        activeGenerator
                    ]
                } Test Data`;
