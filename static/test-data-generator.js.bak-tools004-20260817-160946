    async function copyText(value) {
        try {
            await navigator.clipboard
                .writeText(value);

            toast("Copied to clipboard");
        } catch (_) {
            const textarea =
                document.createElement(
                    "textarea"
                );

            textarea.value = value;

            document.body.appendChild(
                textarea
            );

            textarea.select();

            document.execCommand("copy");

            textarea.remove();

            toast("Copied to clipboard");
        }
    }


    function toast(message) {
        let node =
            $("#qa-testdata-toast");

        if (!node) {
            node =
                document.createElement(
                    "div"
                );

            node.id =
                "qa-testdata-toast";

            node.className =
                "qa-testdata-toast";

            document.body.appendChild(
                node
            );
        }

        node.textContent = message;

        node.classList.add(
            "is-visible"
        );

        window.clearTimeout(
            node._timer
        );

        node._timer =
            window.setTimeout(
                () => {
                    node.classList.remove(
                        "is-visible"
                    );
                },
                1800
            );
    }


    function csvEscape(value) {
        const text =
            String(value ?? "");

        if (
            /[",\n\r]/.test(text)
        ) {
            return (
                '"'
                + text.replace(
                    /"/g,
                    '""'
                )
                + '"'
            );
        }

        return text;
    }


    function asCsv() {
        const headers = [
            "scenario",
            "type",
            "value",
            "expected",
            "reason",
        ];

        const lines = [
            headers.join(","),
        ];

        for (const row of currentRows) {
            lines.push(
                [
                    row.scenario,
                    row.type,
                    row.value,
                    row.expected,
                    row.reason,
                ]
                    .map(csvEscape)
                    .join(",")
            );
        }

        return lines.join("\n");
    }


    function download(
        filename,
        content,
        mime
    ) {
        const blob = new Blob(
            [content],
            {
                type: mime,
            }
        );

        const url =
            URL.createObjectURL(blob);

        const anchor =
            document.createElement("a");

        anchor.href = url;
        anchor.download = filename;

        document.body.appendChild(
            anchor
        );

        anchor.click();
        anchor.remove();

        URL.revokeObjectURL(url);
    }


