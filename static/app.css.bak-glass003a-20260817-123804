@media (max-width: 860px) {
    .nav-toggle {
        display: grid;
        place-items: center;
        z-index: 61;
    }

    .topbar {
        z-index: 60;
    }

    body.nav-open .nav-toggle-icon {
        background: transparent;
    }

    body.nav-open .nav-toggle-icon::before,
    body.nav-open .nav-toggle-icon::after {
        top: 0;
    }

    body.nav-open .nav-toggle-icon::before {
        transform: rotate(45deg);
    }

    body.nav-open .nav-toggle-icon::after {
        transform: rotate(-45deg);
    }

    .site-nav-drawer-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 8px;
    }

    .nav-close {
        width: 40px;
        height: 40px;
        border: 1px solid var(--line);
        border-radius: 10px;
        background: white;
        color: var(--navy);
        cursor: pointer;
        font-size: 24px;
        line-height: 1;
    }

    .site-nav {
        position: fixed;
        top: 0;
        right: 0;
        width: min(280px, 72vw);
        height: 100dvh;
        margin: 0;
        padding:
            calc(18px + env(safe-area-inset-top))
            16px
            calc(24px + env(safe-area-inset-bottom));
        display: flex;
        flex-direction: column;
        align-items: stretch;
        justify-content: flex-start;
        gap: 8px;
        background: #ffffff;
        border-left: 1px solid var(--line);
        box-shadow: -18px 0 40px rgba(20, 33, 61, .12);
        transform: translateX(110%);
        transition: transform .22s ease;
        z-index: 55;
        overflow-y: auto;
    }

    .site-nav.is-open {
        transform: translateX(0);
    }

    .site-nav-link {
        min-height: 48px;
        padding: 0 14px;
        font-size: 16px;
        justify-content: flex-start;
    }

    .site-nav-install:not([hidden]) {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-top: 12px;
        min-height: 48px;
    }

    .nav-backdrop {
        position: fixed;
        inset: 0;
        display: block;
        background: rgba(20, 33, 61, .38);
        z-index: 45;
    }

    .nav-backdrop[hidden] {
        display: none;
    }

    body.nav-open {
        overflow: hidden;
    }

    .hero {
        overflow: visible;
    }

    .hero-actions,
    .trust-row {
        flex-direction: column;
        align-items: stretch;
    }

    .hero-actions a,
    .dashboard-header .primary-button {
        width: 100%;
    }

    .inventory-table-wrap,
    .test-case-table-wrap {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

    input,
    select,
    textarea {
        font-size: 16px;
    }
}

@media (max-width: 620px) {
    .hero h1 {
        font-size: 28px;
        letter-spacing: -0.6px;
        line-height: 1.15;
    }

    .hero p {
        font-size: 15px;
    }

    .simple-card {
        width: calc(100% - 24px);
        margin: 24px auto;
        padding: 28px 18px;
    }

    .dashboard-qubi {
        display: none;
    }

    footer {
        text-align: center;
        padding-bottom: calc(20px + env(safe-area-inset-bottom));
    }
}


