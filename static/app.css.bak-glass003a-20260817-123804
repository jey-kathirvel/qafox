    width: 100%;
    height: 680px;
    border: 0;
    background: #ffffff;
}

.api-guidance-action {
    display: flex;
    justify-content: flex-end;
    margin-top: 16px;
}

.api-guidance-action .primary-button {
    width: auto;
}

.api-guidance-toggle {
    flex: 0 0 auto;
}

@media (max-width: 760px) {

