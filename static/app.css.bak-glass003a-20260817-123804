}

.approval-fox,
.plan-success-fox {
    font-size: 64px;
}

.execution-approval-form {
    display: grid;
    gap: 20px;
}

.approval-section,
.approval-confirmation {
    padding: 24px;
    border: 1px solid #e0e5ef;
    border-radius: 20px;
    background: #fff;
}

.approval-section-heading {
    margin-bottom: 18px;
}

.approval-section-heading span {
    color: #6d43ff;
    font-size: 10px;
    font-weight: 900;
    letter-spacing: .12em;
}

.approval-section-heading h2 {
    margin: 5px 0;
    color: #071b43;
}

.approval-section-heading p {
    margin: 0;
    color: #748097;
    font-size: 13px;
}

.approval-config-label,
.approval-confirmation > label {
    display: grid;
    gap: 8px;
    color: #071b43;
    font-size: 12px;
    font-weight: 900;
}

.approval-config-label select,
.approval-confirmation input[type="text"],
.approval-confirmation input:not([type]) {
