DATABASE_URL=postgresql+psycopg://qafox_user:change-me@127.0.0.1:5432/qafox_db
QAFOX_SECRET_KEY=replace-with-a-long-random-secret
QAFOX_DOMAIN=qafox.ads-ai.in

SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USERNAME=no-reply@example.com
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=QAFox
SMTP_PASSWORD_B64=base64-encoded-smtp-password

TEST_VAULT_KEY=replace-with-a-fernet-key
MFA_ENCRYPTION_KEY=replace-with-a-separate-fernet-key
QAFOX_WORKER_ID=qafox-worker-1
QAFOX_WORKER_POLL_SECONDS=2
QAFOX_PROJECT_ROOT=/opt/qafox/data/projects
QAFOX_STAGING_ROOT=/opt/qafox/data/staging
QAFOX_JOB_ROOT=/tmp/qafox/jobs
QAFOX_GIT_TIMEOUT_SECONDS=180
QAFOX_SEMGREP_CONFIG=p/default
